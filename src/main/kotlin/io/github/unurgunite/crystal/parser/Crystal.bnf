{
  parserClass="io.github.unurgunite.crystal.parser.CrystalParser"

  extends="com.intellij.extapi.psi.ASTWrapperPsiElement"

  psiClassPrefix="Crystal"
  psiImplClassSuffix="Impl"
  psiPackage="io.github.unurgunite.crystal.psi"
  psiImplPackage="io.github.unurgunite.crystal.psi.impl"

  elementTypeHolderClass="io.github.unurgunite.crystal.psi.CrystalTypes"
  elementTypeClass="io.github.unurgunite.crystal.psi.CrystalElementType"
  tokenTypeClass="io.github.unurgunite.crystal.lexer.CrystalTokenType"
  elementTypeFactory("class_definition|module_definition|struct_definition|enum_definition|method_definition|macro_definition|macro_definition_open|constant_assignment")="io.github.unurgunite.crystal.stubs.CrystalStubElementTypeFactory.create"

  tokens = [
    // Keywords
    ABSTRACT="ABSTRACT"
    ALIAS="ALIAS"
    ANNOTATION="ANNOTATION"
    AS="AS"
    AS_QUESTION="AS_QUESTION"
    ASM="ASM"
    BEGIN="BEGIN"
    BREAK="BREAK"
    CASE="CASE"
    CLASS="CLASS"
    DEF="DEF"
    DO="DO"
    ELSE="ELSE"
    ELSIF="ELSIF"
    END="END"
    ENSURE="ENSURE"
    ENUM="ENUM"
    EXTEND="EXTEND"
    FALSE="FALSE"
    FOR="FOR"
    FORALL="FORALL"
    FUN="FUN"
    IF="IF"
    IN="IN"
    INCLUDE="INCLUDE"
    INSTANCE_SIZEOF="INSTANCE_SIZEOF"
    IS_A="IS_A"
    LIB="LIB"
    MACRO="MACRO"
    MODULE="MODULE"
    NEXT="NEXT"
    NIL="NIL"
    NIL_QUESTION="NIL_QUESTION"
    OF="OF"
    OFFSETOF="OFFSETOF"
    OUT="OUT"
    POINTEROF="POINTEROF"
    PREVIOUS_DEF="PREVIOUS_DEF"
    PRIVATE="PRIVATE"
    PROTECTED="PROTECTED"
    REQUIRE="REQUIRE"
    RESCUE="RESCUE"
    RESPONDS_TO="RESPONDS_TO"
    RETURN="RETURN"
    SELECT="SELECT"
    SELF="SELF"
    SIZEOF="SIZEOF"
    STRUCT="STRUCT"
    SUPER="SUPER"
    THEN="THEN"
    TRUE="TRUE"
    TYPEOF="TYPEOF"
    UNINITIALIZED="UNINITIALIZED"
    UNION="UNION"
    UNLESS="UNLESS"
    UNTIL="UNTIL"
    VERBATIM="VERBATIM"
    WHEN="WHEN"
    WHILE="WHILE"
    WITH="WITH"
    YIELD="YIELD"

    // Literals
    INTEGER_LITERAL="INTEGER_LITERAL"
    FLOAT_LITERAL="FLOAT_LITERAL"
    CHAR_LITERAL="CHAR_LITERAL"
    STRING_LITERAL="STRING_LITERAL"
    STRING_INTERPOLATION_BEGIN="STRING_INTERPOLATION_BEGIN"
    STRING_INTERPOLATION_END="STRING_INTERPOLATION_END"
    COMMAND_LITERAL="COMMAND_LITERAL"
    COMMAND_BEGIN="COMMAND_BEGIN"
    COMMAND_END="COMMAND_END"
    REGEX_LITERAL="REGEX_LITERAL"
    SYMBOL_LITERAL="SYMBOL_LITERAL"
    HEREDOC_START="HEREDOC_START"
    HEREDOC_CONTENT="HEREDOC_CONTENT"
    HEREDOC_END="HEREDOC_END"
    STRING_ESCAPE="STRING_ESCAPE"
    PERCENT_LITERAL_BEGIN="PERCENT_LITERAL_BEGIN"
    PERCENT_LITERAL_END="PERCENT_LITERAL_END"
    PERCENT_SYMBOL_BEGIN="PERCENT_SYMBOL_BEGIN"
    PERCENT_SYMBOL_END="PERCENT_SYMBOL_END"
    SYMBOL_COLON="SYMBOL_COLON"

    // Macro body tokens
    MACRO_BODY_CONTENT="MACRO_BODY_CONTENT"
    MACRO_FRESH_VAR="MACRO_FRESH_VAR"
    MACRO_INTERPOLATION_BEGIN="MACRO_INTERPOLATION_BEGIN"
    MACRO_INTERPOLATION_END="MACRO_INTERPOLATION_END"
    MACRO_CONTROL_BEGIN="MACRO_CONTROL_BEGIN"
    MACRO_CONTROL_END="MACRO_CONTROL_END"

    // Identifiers
    IDENTIFIER="IDENTIFIER"
    CONSTANT="CONSTANT"
    INSTANCE_VAR="INSTANCE_VAR"
    CLASS_VAR="CLASS_VAR"
    GLOBAL_VAR="GLOBAL_VAR"

    // Operators
    PLUS="PLUS"
    MINUS="MINUS"
    STAR="STAR"
    SLASH="SLASH"
    DOUBLE_SLASH="DOUBLE_SLASH"
    PERCENT="PERCENT"
    AMPERSAND="AMPERSAND"
    PIPE="PIPE"
    CARET="CARET"
    TILDE="TILDE"
    DOUBLE_STAR="DOUBLE_STAR"
    UNARY_MINUS="UNARY_MINUS"
    UNARY_PLUS="UNARY_PLUS"
    SPLAT="SPLAT"
    WRAP_NEG="WRAP_NEG"
    WRAP_PLUS="WRAP_PLUS"
    WRAP_MINUS="WRAP_MINUS"
    WRAP_STAR="WRAP_STAR"
    WRAP_DOUBLE_STAR="WRAP_DOUBLE_STAR"
    LSHIFT="LSHIFT"
    RSHIFT="RSHIFT"
    EQ="EQ"
    NEQ="NEQ"
    LT="LT"
    GT="GT"
    LTE="LTE"
    GTE="GTE"
    SPACESHIP="SPACESHIP"
    CASE_EQ="CASE_EQ"
    MATCH_OP="MATCH_OP"
    BANG="BANG"
    AND_AND="AND_AND"
    OR_OR="OR_OR"
    ASSIGN="ASSIGN"
    PLUS_ASSIGN="PLUS_ASSIGN"
    MINUS_ASSIGN="MINUS_ASSIGN"
    STAR_ASSIGN="STAR_ASSIGN"
    SLASH_ASSIGN="SLASH_ASSIGN"
    PERCENT_ASSIGN="PERCENT_ASSIGN"
    AMPERSAND_ASSIGN="AMPERSAND_ASSIGN"
    PIPE_ASSIGN="PIPE_ASSIGN"
    CARET_ASSIGN="CARET_ASSIGN"
    DOUBLE_STAR_ASSIGN="DOUBLE_STAR_ASSIGN"
    WRAP_PLUS_ASSIGN="WRAP_PLUS_ASSIGN"
    WRAP_MINUS_ASSIGN="WRAP_MINUS_ASSIGN"
    WRAP_STAR_ASSIGN="WRAP_STAR_ASSIGN"
    WRAP_DOUBLE_STAR_ASSIGN="WRAP_DOUBLE_STAR_ASSIGN"
    DOUBLE_SLASH_ASSIGN="DOUBLE_SLASH_ASSIGN"
    LSHIFT_ASSIGN="LSHIFT_ASSIGN"
    RSHIFT_ASSIGN="RSHIFT_ASSIGN"
    OR_OR_ASSIGN="OR_OR_ASSIGN"
    AND_AND_ASSIGN="AND_AND_ASSIGN"
    DOT="DOT"
    DOTDOT="DOTDOT"
    DOTDOTDOT="DOTDOTDOT"
    ARROW="ARROW"
    DOUBLE_ARROW="DOUBLE_ARROW"
    QUESTION="QUESTION"
    COLON="COLON"
    DOUBLE_COLON="DOUBLE_COLON"
    SEMICOLON="SEMICOLON"
    COMMA="COMMA"
    HASH="HASH"
    AT="AT"

    // Delimiters
    LPAREN="LPAREN"
    RPAREN="RPAREN"
    LBRACKET="LBRACKET"
    RBRACKET="RBRACKET"
    LBRACE="LBRACE"
    RBRACE="RBRACE"

    // Whitespace & Comments
    LINE_COMMENT="LINE_COMMENT"
    NEWLINE="NEWLINE"
    // Escaped macro delimiters (`\{%`, `\{{` — the lexer emits BACKSLASH and
    // pushes back the delimiter so it re-lexes as macro code).
    BACKSLASH="BACKSLASH"
  ]
}

// ==================== Top Level ====================

crystalFile ::= top_level_statement*

private top_level_statement ::= NEWLINE
                              | SEMICOLON
                              | require_statement
                              | include_statement
                              | extend_statement
                              | annotation_usage
                              | class_definition
                              | module_definition
                              | struct_definition
                              | enum_definition
                              | record_definition
                              | lib_definition
                              | top_level_fun
                              | annotation_definition
                              | method_definition
                              | macro_definition
                              | macro_definition_open
                              | alias_definition
                              | visibility_modifier
                              | macro_control
                              | property_macro
                              | statement

// ==================== Require / Include / Extend ====================

require_statement ::= REQUIRE string_expression {pin=1}

include_statement ::= INCLUDE type_reference {pin=1}

extend_statement ::= EXTEND (type_reference | SELF) {pin=1}

// ==================== Type Definitions ====================

// Type definitions accept qualified names (`struct HTTP::Headers`): the stub name
// keeps the simple name (after the last `::`), the full path is rebuilt by
// CrystalPsiUtils.buildQualifiedName. Pins are load-bearing: they commit the
// definition so a failure deep inside the body still yields a partial tree
// (name + members parsed so far) for the StubIndex, instead of failing the
// whole definition with the error misreported at its start.
class_definition ::= [ABSTRACT] CLASS type_name [type_parameters] [superclass_clause] class_body END {
  pin(".*")=2
  stubClass="io.github.unurgunite.crystal.stubs.CrystalClassDefinitionStub"
  mixin="io.github.unurgunite.crystal.psi.impl.CrystalStubbedClassDefinitionImpl"
  implements="io.github.unurgunite.crystal.psi.CrystalNamedElement"
}

superclass_clause ::= LT type_reference

module_definition ::= MODULE type_name [type_parameters] class_body END {
  pin=1
  stubClass="io.github.unurgunite.crystal.stubs.CrystalModuleDefinitionStub"
  mixin="io.github.unurgunite.crystal.psi.impl.CrystalStubbedModuleDefinitionImpl"
  implements="io.github.unurgunite.crystal.psi.CrystalNamedElement"
}

struct_definition ::= [ABSTRACT] STRUCT type_name [type_parameters] [superclass_clause] class_body END {
  pin(".*")=2
  stubClass="io.github.unurgunite.crystal.stubs.CrystalStructDefinitionStub"
  mixin="io.github.unurgunite.crystal.psi.impl.CrystalStubbedStructDefinitionImpl"
  implements="io.github.unurgunite.crystal.psi.CrystalNamedElement"
}

enum_definition ::= ENUM type_name [COLON type_reference] enum_body END {
  pin=1
  stubClass="io.github.unurgunite.crystal.stubs.CrystalEnumDefinitionStub"
  mixin="io.github.unurgunite.crystal.psi.impl.CrystalStubbedEnumDefinitionImpl"
  implements="io.github.unurgunite.crystal.psi.CrystalNamedElement"
}

lib_definition ::= LIB CONSTANT lib_body END {pin=1}

// `record` is a stdlib macro that expands to a class (e.g. `record Point(x : Int32, y : Int32)`).
// It is parsed as a definition so stdlib files containing records (string.cr, array.cr, hash.cr,
// ...) parse cleanly; otherwise the unparsed record breaks the whole file's StubIndex. Not stubbed
// (record names are not separately indexed), but the body parses so enclosed methods/constants do.
// Field names may be keywords (`record ZoneTransition, when : Int64`, `record T, type : X`,
// `record Hook, scope : M, macro : Macro` — all verified against the real compiler).
// The `do` body is a class_body (not a block): record members include definitions
// that statements lack (`private def`, properties...). Verified: http/headers.cr
// `record Key, name : String do ... private def normalize_byte ... end`.
// The body REQUIRES `do` (verified with the real compiler: a DO-less indented
// `def` after `record R, x : Int32` is a separate top-level method, not a record
// member — `R.new(5).foo` fails with "undefined method 'foo' for R"). An earlier
// revision had a DO-less `class_body END` alternative and it ate the enclosing
// definition's `end` (`record EndOfRequest` inside `module HTTP` consumed the
// module's `end`, breaking all of http/common.cr past that point): with an empty
// class_body, `class_body END` matches the outer `end` and PEG commits to it.
record_definition ::= RECORD type_name [type_parameters] [COMMA NLS record_field (COMMA NLS record_field)*] (DO class_body END)? {pin=1}

record_field ::= (IDENTIFIER | keyword_as_record_field) [COLON type_reference] [ASSIGN expression] | STAR

// Keywords observed as `record` field names in the stdlib / verified valid
// (`record R, macro : M` lexes `macro` as a plain identifier — it is not a
// reserved word — so listed keywords cover the reserved ones; other names
// arrive as IDENTIFIER).
private keyword_as_record_field ::= WHEN | TYPE | IN | OUT | AS | OF | SELF | NEXT | CLASS | LIB | FUN | END | DO | IF | THEN | ELSE | MACRO
                                  | ABSTRACT | ALIAS | ASM | BEGIN | BREAK | CASE | DEF | ELSIF | ENSURE | ENUM | EXTEND | FALSE | FOR | FORALL | INCLUDE | IS_A | MODULE | NIL | NIL_QUESTION | OFFSETOF | POINTEROF | PRIVATE | PROTECTED | REQUIRE | RESCUE | RESPONDS_TO | RETURN | SELECT | SIZEOF | STRUCT | SUPER | TRUE | TYPEOF | UNINITIALIZED | UNION | UNLESS | UNTIL | VERBATIM | WHILE | WITH | YIELD | PREVIOUS_DEF | INSTANCE_SIZEOF

annotation_definition ::= ANNOTATION type_name (NEWLINE | SEMICOLON)* END {pin=1}

annotation_usage ::= AT LBRACKET type_path [LPAREN NLS argument_list NLS RPAREN] RBRACKET

// C-style function-pointer aliases may list comma-separated parameter types with an optional
// return arrow: `alias AllocFunc = Void*, UInt, UInt -> Void*`.
alias_definition ::= ALIAS type_name ASSIGN type_reference (COMMA NLS type_reference)* [ARROW NLS type_reference] {pin=1}

// ==================== Type Bodies ====================

class_body ::= class_member*

private class_member ::= NEWLINE
               | SEMICOLON
               | annotation_usage
               | annotation_definition
               | abstract_method_definition
               | method_definition
               | macro_definition
               | macro_definition_open
               | class_definition
               | module_definition
               | struct_definition
               | enum_definition
               | record_definition
               | lib_definition
               | include_statement
               | extend_statement
               | alias_definition
               | visibility_modifier
               | property_declaration
               | property_macro
               | macro_control
               | statement

enum_body ::= enum_member*

private enum_member ::= NEWLINE | SEMICOLON | annotation_usage | enum_constant | method_definition | macro_control | enum_class_var | visibility_modifier

// Class variables at enum-body level (`@@kind_ids = ...` inside `enum`, used
// with nil-cast since enum bodies allow no property declarations).
// CLASS_VAR never lexes in isolation (`@@x` is one token), so match the access
// composite — the lexer rule order guarantees the composite reading.
private enum_class_var ::= class_var_access ASSIGN NLS expression

enum_constant ::= (CONSTANT | macro_interpolation) [ASSIGN expression]

lib_body ::= lib_member*

private lib_member ::= NEWLINE | SEMICOLON | annotation_usage | macro_control | fun_definition | type_alias_lib | lib_type_alias | lib_struct_definition | lib_union_definition | enum_definition | lib_external_var | lib_field | constant_assignment | include_statement | extend_statement

lib_field ::= (IDENTIFIER | CONSTANT | keyword_as_method) COLON type_reference

lib_external_var ::= GLOBAL_VAR [ASSIGN primary_expression] COLON type_reference

// `fun` in a `lib` block (external C binding). Supports:
//  - stdcall name decoration: `fun MessageBox@16(...)`
//  - aliasing:               `fun chown = __posix_chown(x0 : ..., ...) : Int`
//  - keyword names:          `fun select(...)` (C names that are Crystal keywords)
//  - PascalCase/CONSTANT names: `fun LocalFree(...)`, `fun FormatMessageA(...)` (Windows bindings)
// The parameter list always sits in the same position (after the optional `= alias` name),
// so the generated PSI exposes a single `parameterList`.
fun_definition ::= FUN interpolated_name [AT INTEGER_LITERAL] [ASSIGN (interpolated_name | string_expression)] [LPAREN NLS parameter_list NLS RPAREN] [COLON type_reference] {pin=1}

private interpolated_name ::= macro_interpolation (IDENTIFIER | CONSTANT)?
                              | (IDENTIFIER | CONSTANT | keyword_as_method) (macro_interpolation (IDENTIFIER | CONSTANT)?)*

top_level_fun ::= FUN interpolated_name [AT INTEGER_LITERAL] [LPAREN NLS parameter_list NLS RPAREN] [COLON type_reference] method_body END {pin=1}

// C function-pointer aliases can list comma-separated parameter types with an optional return:
// `alias Handler = WCHAR*, WCHAR*, UInt -> Int`. Allow a comma-separated type list (function
// pointer signature) in addition to a single type.
type_alias_lib ::= ALIAS CONSTANT ASSIGN type_reference (COMMA NLS type_reference)* [ARROW NLS type_reference]

lib_type_alias ::= IDENTIFIER CONSTANT ASSIGN type_reference
                 | TYPE CONSTANT ASSIGN type_reference

lib_struct_definition ::= STRUCT CONSTANT lib_body END
                        | STRUCT CONSTANT NEWLINE

lib_union_definition ::= UNION CONSTANT lib_body END
                       | UNION CONSTANT NEWLINE

// ==================== Methods ====================

// Macro-split signature (`indexable/mutable.cr` `map!`: `{% if v >= 0 %}
// def map!(& : T -> _) : self {% else %} def map!(&) {% end %}` + ONE shared
// body + `end` — each `{% %}` branch carries a complete variant header, only
// one survives expansion). The `(NLS macro_control DEF ...)*` tail consumes
// the `{% else %} DEF-variant` middles; the final `{% end %}` stays in
// method_body's macro-interleave path (same as statement-level macro-if
// chains). Single sequence, no intra-rule alternative: pin(".*")=2 commits
// after DEF+name, so an alternative there could never fall back.
// The variant DEF is REQUIRED (not optional): a def whose BODY merely starts
// with `{% if %}` must not lose its first control to this tail (verified:
// optional variant breaks `def f \n {% if y %} bar {% end %} \n end` — the
// body loses `{% if %}` and the trailing `{% end %}` dangles). The stub name
// stays correct: findNameIdentifierInMethodName takes the FIRST direct
// IDENTIFIER child, which is always the main header's name.
// The variant header lives in a private wrapper rule (NOT inline): inlining
// a second parameter_list/type_reference directly under method_definition
// flips the existing single getters (getParameterList, getTypeReference, …)
// into List getters and breaks all Kotlin call sites (verified 2026-09-16).
// The wrapper carries its own single getters; method_definition only gains
// getMethodVariantHeaderList, touching no existing code. (Flat token
// alternatives must stay inline — named wrappers around bare tokens emit
// duplicate flat+wrapper getters that break kotlinc; this wrapper holds
// only sub-rule refs, so it is safe.)
method_definition ::= DEF method_name [LPAREN NLS parameter_list NLS RPAREN] [COLON type_reference] [FORALL CONSTANT (COMMA CONSTANT)*] (NLS method_variant_header)* [method_body END] {
  pin(".*")=2
  stubClass="io.github.unurgunite.crystal.stubs.CrystalMethodDefinitionStub"
  mixin="io.github.unurgunite.crystal.psi.impl.CrystalStubbedMethodDefinitionImpl"
  implements="io.github.unurgunite.crystal.psi.CrystalNamedElement"
}

// One `{% else %} DEF-variant` middle of a macro-split signature (see above).
// PUBLIC (own PSI node CrystalMethodVariantHeader): keeps method_definition's
// own parameter_list/type_reference getters single, so no Kotlin call site
// changes. Holds only sub-rule refs (never bare tokens) — no
// duplicate-getter hazard (that trap is specific to named wrappers around
// bare tokens; method_body/parameter_list prove sub-rule wrappers are safe).
// NLS between macro_control and DEF is load-bearing: `{% else %}` and the
// variant `def` are on separate lines (verified 2026-09-16: without it the
// variant never fires — NEWLINE is a real token, not whitespace).
// No guard, no pin: the REQUIRED DEF self-protects (a plain `{% end %}` or
// a body-opening `{% if %}` fails the variant inside the `(...)*` loop,
// which simply ends and lets method_body take over).
// Plain public rule (own PSI node, single getters — see above); NOT private:
// a private rule inlines (no node) and its parameter_list/type_reference
// children would flip method_definition's getters to List (verified
// 2026-09-16: private variant broke 30+ Kotlin call sites).
method_variant_header ::= macro_control NLS DEF method_name [LPAREN NLS parameter_list NLS RPAREN] [COLON type_reference] [FORALL CONSTANT (COMMA CONSTANT)*]

// Bodiless `abstract def foo` (Crystal forbids bodies on abstract defs —
// verified: `abstract def foo : Int32; 1; end` is a compile error).
// Same stub contract as method_definition so OverrideImplement finds them.
abstract_method_definition ::= ABSTRACT DEF method_name [LPAREN NLS parameter_list NLS RPAREN] [COLON type_reference] [FORALL CONSTANT (COMMA CONSTANT)*]

private method_name ::= IDENTIFIER [macro_interpolation] [BANG|QUESTION] [ASSIGN]
                      | type_path DOT (IDENTIFIER | CONSTANT | keyword_as_method | operator_method_name | macro_interpolation) [BANG|QUESTION] [ASSIGN]
                      | CONSTANT [macro_interpolation] [BANG|QUESTION] [ASSIGN]
                      | SELF DOT (IDENTIFIER [macro_interpolation] | CONSTANT | keyword_as_method | operator_method_name | macro_interpolation) [BANG|QUESTION] [ASSIGN]
                      // Operator `def` names (`def []`, `def []?`, `def []=`,
                      // `def !~`, `def ==` — array.cr/match_data.cr/string.cr):
                      // `[]` lexes as TWO tokens (LBRACKET RBRACKET), so the
                      // single-token operator_method_name arm can't match them.
                      // Disjoint first token (LBRACKET) — plain names keep
                      // their shapes (goldens confirm). Commits on the pair
                      // (fail-fast: `[` alone never matches a method name).
                      | LBRACKET RBRACKET [QUESTION | ASSIGN] [BANG|QUESTION]
                      // NOTE: the DOT-first form stays before the lone `{{a}}` form
                      // (PEG longer-first); the MacroSetter shape change comes from
                      // the new DOT AT / interpolated_method_segment alternatives in
                      // dot_call_access, which now attach `.{{...}}` as a postfix
                      // instead of an implicit-object bare arg.
                      | macro_interpolation DOT (IDENTIFIER | CONSTANT | keyword_as_method | operator_method_name | macro_interpolation) [BANG|QUESTION] [ASSIGN]
                      | macro_interpolation [BANG|QUESTION] [ASSIGN]
                      // PEG longer-first: operator_method_name precedes keyword_as_method
                      // because both match bare `&`/`+`/etc. single tokens, but only the
                      // operator rule has the longer `&{{op}}` / `!~` forms (`def &{{op.id}}`
                      // — primitives.cr). A bare-keyword match would commit first and leave
                      // the `{{...}}` unparsed.
                      | operator_method_name
                      | keyword_as_method [ASSIGN]
                      | macro_interpolation
                      // Backtick command-literal name (`def \`(command : String) : String`
                      // — process.cr; the lexer emits COMMAND_BEGIN without entering
                      // the BACKTICK state in method-name position, see Crystal.flex).
                      | COMMAND_BEGIN

private operator_method_name ::= PLUS | MINUS | STAR | SLASH | PERCENT | AMPERSAND macro_interpolation | AMPERSAND | PIPE | CARET | TILDE
                               | BANG TILDE
                               | WRAP_PLUS | WRAP_MINUS | WRAP_STAR | WRAP_DOUBLE_STAR
                               | DOUBLE_STAR | LSHIFT | RSHIFT | EQ | NEQ | LT | GT | LTE | GTE
                               | SPACESHIP | CASE_EQ | MATCH_OP | LBRACKET RBRACKET ASSIGN | LBRACKET RBRACKET QUESTION | LBRACKET RBRACKET

method_body ::= statement_list rescue_clause+ [else_clause] [ensure_clause]
              | statement_list [else_clause] [ensure_clause]
              // `{% ... %}`-managed bodies (`{% begin %}`, macro-generated
              // `rescue`/`ensure` — http/server.cr `{% begin %} begin ...
              // ensure {% end %}` shape): raw macro controls interleave with
              // statements, so neither plain alternative commits. Fail-fast
              // `{%` guard keeps macro-free bodies on the plain paths.
              // The tail inlines (macro_control | statement_list)+ directly:
              // a named private rule would make GrammarKit emit a duplicate
              // flat+wrapper getStatementListList() overload pair that breaks
              // kotlinc (verified twice: tuple_literal, array_literal).
              | statement_list &(macro_control) (macro_control | statement_list)+ [rescue_clause+] [else_clause] [ensure_clause]

macro_body ::= macro_body_element*

private macro_body_element ::= MACRO_BODY_CONTENT
                             | MACRO_FRESH_VAR
                             | macro_interpolation
                             | macro_control
                             | NEWLINE
                             // Escaped macro delimiters (`\{%`, `\{{` — big_int.cr,
                             // llvm.cr, ecr/macros.cr): the `\` suppresses
                             // immediate expansion; the content stays TEXT.
                             // The lexer already emits matching BEGIN tokens
                             // (pushState like the unescaped forms); here they
                             // parse as opaque body text — the matching ENDs
                             // ride the same rule (nesting via macro_control /
                             // macro_interpolation recursion stays balanced).
                             // The content soup mirrors macro_control's own
                             // (NOT macro_control_content*: after an escaped
                             // `{{n}}` the lexer emits MACRO_BODY_CONTENT for
                             // `}}` and bare `%`/`}` tokens, which the content
                             // rule rejects — verified 2026-09-16: the
                             // structured content alternative NEVER fires on
                             // `\{% if Int{{n}} == X %}`, only the soup does).
                             | BACKSLASH MACRO_CONTROL_BEGIN macro_escaped_content* MACRO_CONTROL_END
                             | BACKSLASH MACRO_INTERPOLATION_BEGIN (bare_command_expression | expression)? MACRO_INTERPOLATION_END

// Flat token soup for escaped `\{%...%}` bodies (see above): every token the
// macro lexers can emit, with NO structure (the body is TEXT — even
// `MACRO_INTERPOLATION_BEGIN`/`END` pairs are opaque). The nested `{%`/`{{`
// push real states (balanced by their ENDs via macro_control /
// macro_interpolation recursion). Deliberately NOT reusing
// macro_control_content (which requires structured interpolations).
private macro_escaped_content ::= macro_control_token | macro_control | macro_interpolation | macro_escaped_interpolation | macro_percent_literal | HEREDOC_START | HEREDOC_CONTENT | HEREDOC_END | STRING_ESCAPE | STRING_INTERPOLATION_BEGIN | STRING_INTERPOLATION_END | BACKSLASH | MACRO_BODY_CONTENT | MACRO_INTERPOLATION_BEGIN | MACRO_INTERPOLATION_END | NEWLINE | SEMICOLON
                             // Generated-code fragments the MACRO_BODY lexer
                             // leaves as structured tokens (they sit INSIDE
                             // macro text, so real crystal would reject them
                             // as code — verified illegal 1.21.0 — but the
                             // bodies are TEXT and the tokens must parse as
                             // SOMETHING): `=`/`(`/`)`/`[`/`]`/`]`-tails around
                             // `{{...}}` (`def f({{...}})`,
                             // `y = [{{...}}]` — macros.cr `record`). Each is
                             // a lone token element; the parser pairs them
                             // only by position, never as real syntax.
                             | ASSIGN
                             | LPAREN | RPAREN
                             | LBRACKET | RBRACKET

macro_interpolation ::= MACRO_INTERPOLATION_BEGIN NLS (bare_command_expression | expression) NLS MACRO_INTERPOLATION_END
                      | MACRO_INTERPOLATION_BEGIN NLS (bare_command_expression | expression) NLS RBRACE
                      // Macro-splat parameter (`def initialize({{ x.map ...
                      // end.splat }})` — macros.cr `record`): ILLEGAL in real
                      // crystal (verified 1.21.0: `unexpected token "{{"`),
                      // but macro bodies are TEXT — the lexer emits
                      // MACRO_BODY_CONTENT for the def text and the `{{` must
                      // parse as SOMETHING, or one error node orphans the
                      // whole macro tail. Tolerated leniency (same precedent
                      // as `{% %}` in `def` params, see docs/reports/wave-9-grammar.md).
                      // NLS inside (Reflect(X) in enumerable.cr puts `{{` /
                      // `}}` on their own lines): NLS is private (inlines, no
                      // shape change when absent).
                      | MACRO_INTERPOLATION_BEGIN NLS (bare_command_expression | expression)? NLS MACRO_INTERPOLATION_END

macro_control ::= MACRO_CONTROL_BEGIN macro_control_content* MACRO_CONTROL_END

// Escaped `\{%...%}` / `\{{...}}` at statement level (big_int.cr, llvm.cr,
// ecr/macros.cr: `\{% if Int{{n}} == X %}` / `\{{ run(...) }}` inside
// `{% for %}`-generated defs). Real crystal rejects `\{%` at true statement
// level (verified 1.21.0: `unknown token: '{'`), but inside macro `{% for %}`
// bodies it is body TEXT — and our `{% for %}` design parses the body as
// sibling statements, so the escaped controls surface here. Tolerated
// leniency (same precedent as macro_definition_open). PUBLIC wrapper (own
// PSI node, composite refs only — no duplicate-getter hazard); BACKSLASH
// first token keeps it fail-fast (zero impact on BACKSLASH-free code —
// BACKSLASH only ever precedes `{%`/`{{`).
escaped_macro_statement ::= BACKSLASH macro_control
                          | BACKSLASH macro_interpolation

// Inline `{% if %} A {% else %} B {% end %}` as an EXPRESSION operand
// (`ei_class == {% if flag?(:bits64) %} CLASS_64 {% else %} CLASS_32 {% end %} && ...`
// — elf.cr `valid?`): at expansion time the branch yields one value, so real
// crystal parses the whole chain as one `&&` expression (verified 1.21.0).
// Without this, each `{%...%}` parses as a lone statement-level control and
// the `&&` dangles. PEG longer-first: sits BEFORE plain macro_control in
// primary_expression. Fail-fast guard `{% IF/UNLESS` keeps every other
// control on the plain shape (goldens confirm). Branch `expression`s stop
// naturally before `{%` (no expression continues over MACRO_CONTROL_BEGIN).
// `(macro_control expression)*` covers `{% elsif %}`/`{% else %}` middles;
// the final macro_control is the `{% end %}`. Nested macro-ifs recurse
// through expression → primary (each level consumes ≥1 control, terminates).
// Statement-level `{% if %}` blocks are unaffected: `statement` tries plain
// macro_control BEFORE expression_statement, so a leading `{%` never reaches
// here at statement start. Also fixes `{% if %}` as named-arg value
// (`new(x: {% if a %} 1 {% else %} 2 {% end %})` — status.cr) via expression.
private macro_if_expression ::= &(MACRO_CONTROL_BEGIN (IF | UNLESS)) macro_control expression (macro_control expression)* macro_control

private macro_control_content ::= macro_control_token | macro_control | macro_interpolation | macro_escaped_interpolation | macro_percent_literal | HEREDOC_START | HEREDOC_CONTENT | HEREDOC_END | STRING_ESCAPE | STRING_INTERPOLATION_BEGIN | STRING_INTERPOLATION_END | BACKSLASH | fun_definition | lib_struct_definition | lib_union_definition | enum_definition | lib_external_var | lib_field | constant_assignment | type_alias_lib | lib_type_alias | annotation_usage
                              | for_statement

// Escaped-nested `{{...}}` inside macro code (`\{% if Int{{n}} == X %}` —
// big_int.cr, llvm.cr): the lexer's MACRO_INTERPOLATION `{{` rule emits
// MACRO_BODY_CONTENT for `}}` (it thinks a `{{`-nesting opened), so the
// structured macro_interpolation rule can never match. This flat fallback
// consumes the interpolation as opaque body text (same swallowing shape as
// the BACKSLASH body-text rule). AFTER macro_interpolation (PEG: real
// interpolations keep their shape). No new PSI type.
private macro_escaped_interpolation ::= MACRO_INTERPOLATION_BEGIN (macro_control_token | BACKSLASH | MACRO_BODY_CONTENT | MACRO_INTERPOLATION_BEGIN | MACRO_INTERPOLATION_END | NEWLINE)+

// Heredoc inside `{% %}` (`{% raise <<-TXT unless kwargs.empty? ... TXT %}`
// — macros.cr `record`): the lexer emits HEREDOC_START on the opener line,
// body content, and HEREDOC_END at the marker (MACRO_HEREDOC_BODY state pops
// back to MACRO_CONTROL). FLAT tokens in the content soup (NOT a structured
// START..END rule): the opener line carries ordinary macro code BETWEEN the
// start and the body (`raise <<-TXT unless x.empty?` — the heredoc is a call
// argument, the `unless` a postfix modifier), so no contiguity exists to
// match. STRING_ESCAPE covers raw heredocs (`\`` etc.); the INTERPOLATION
// pair covers `#{name}` inside non-raw bodies (the lexer pushes the shared
// INTERPOLATION state, which pops back into the heredoc body).

// Percent literal inside `{% %}` / `{{ }}` (`{% for mod in %w(LittleEndian
// BigEndian) %}` — MacroForAssign golden, real stdlib shape): the lexer now
// emits proper PERCENT_* tokens there (not PERCENT+IDENTIFIER+LPAREN), so the
// content needs a structured rule mirroring percent_literal (BEGIN content*
// END — NOT flat tokens, or unbalanced fragments would parse). No new PSI
// type: reuses the percent_literal shape… — no, own private rule (sharing
// percent_literal directly would attach PERCENT_LITERAL PSI inside macro
// controls; keep macro bodies token-flat like everything else here).
private macro_percent_literal ::= PERCENT_LITERAL_BEGIN macro_percent_content* PERCENT_LITERAL_END
                                | PERCENT_SYMBOL_BEGIN macro_percent_symbol_content* PERCENT_SYMBOL_END
private macro_percent_content ::= STRING_LITERAL | STRING_ESCAPE | STRING_INTERPOLATION_BEGIN expression STRING_INTERPOLATION_END | SYMBOL_LITERAL | REGEX_LITERAL | COMMAND_LITERAL | NEWLINE
private macro_percent_symbol_content ::= SYMBOL_LITERAL | NEWLINE

private macro_control_token ::= IDENTIFIER | CONSTANT | INSTANCE_VAR | CLASS_VAR
                              | INTEGER_LITERAL | FLOAT_LITERAL | STRING_LITERAL | STRING_ESCAPE | STRING_INTERPOLATION_BEGIN | STRING_INTERPOLATION_END
                              | SYMBOL_LITERAL | SYMBOL_COLON | CHAR_LITERAL
                              | TRUE | FALSE | NIL
                              | IF | ELSE | ELSIF | END | FOR | IN | UNLESS | BEGIN | YIELD | VERBATIM
                              | LPAREN | RPAREN | LBRACKET | RBRACKET | LBRACE | RBRACE | COMMA | DOT | COLON
                              | EQ | NEQ | LT | GT | LTE | GTE | OR_OR | AND_AND | PIPE | AMPERSAND
                              | ASSIGN | PLUS | MINUS | STAR | DOUBLE_STAR | SLASH | DOUBLE_SLASH | QUESTION | BANG | CARET | TILDE | DOTDOT | DOTDOTDOT
                              | LSHIFT | RSHIFT
                              | DOUBLE_COLON | PERCENT
                              | REGEX_BEGIN | REGEX_LITERAL | REGEX_END
                              | NEWLINE | SEMICOLON | HASH | AT | ARROW | ANNOTATION
                              | COMMAND_BEGIN | COMMAND_LITERAL | COMMAND_END
                              | MACRO_INTERPOLATION_BEGIN | MACRO_INTERPOLATION_END
                              | MACRO_BODY_CONTENT
                              | DO | DEF | CLASS | MODULE | STRUCT | ENUM | MACRO | RETURN | BREAK | NEXT
                              | THEN | WHEN | CASE | WHILE | UNTIL | RESCUE | ENSURE | FUN | LIB | TYPE | ALIAS
                              | AS | OF | IS_A | NIL_QUESTION | RESPONDS_TO | ABSTRACT | PROTECTED | PRIVATE
                              | SELECT | SUPER | PREVIOUS_DEF | WITH | UNION | EXTEND | INCLUDE | REQUIRE
                              | TYPEOF | SELF | ASM | FORALL | OUT | POINTEROF | SIZEOF | INSTANCE_SIZEOF
                              | OFFSETOF | UNINITIALIZED

macro_definition ::= MACRO method_name [LPAREN NLS parameter_list NLS RPAREN] macro_body END {
  pin=1
  stubClass="io.github.unurgunite.crystal.stubs.CrystalMacroDefinitionStub"
  mixin="io.github.unurgunite.crystal.psi.impl.CrystalStubbedMacroDefinitionImpl"
  implements="io.github.unurgunite.crystal.psi.CrystalNamedElement"
}

// Unclosed `macro` (macro TEXT containing generated-code fragments, e.g.
// `def f({{...}})` — macros.cr `record`, ILLEGAL in real crystal but macro
// bodies are TEXT): MACRO_BODY's def-text never flips back to YYINITIAL, so
// no `end` token ever closes the macro. Instead of one error node orphaning
// the whole macro tail, tolerate the header + body WITHOUT the closing END
// (the orphaned `{{...}}` fragments parse as macro_body_elements above).
// AFTER the closed alternative (PEG: real macros keep their shape).
// Same pin/stub/mixin contract (it IS a definition, for the index).
macro_definition_open ::= MACRO method_name [LPAREN NLS parameter_list NLS RPAREN] macro_body {
  pin=1
  stubClass="io.github.unurgunite.crystal.stubs.CrystalMacroDefinitionStub"
  mixin="io.github.unurgunite.crystal.psi.impl.CrystalStubbedMacroDefinitionImpl"
  implements="io.github.unurgunite.crystal.psi.CrystalMacroDefinition"
}

// ==================== Parameters ====================

parameter_list ::= [parameter_item (COMMA NLS parameter_item)* [NLS COMMA]]

private parameter_item ::= bare_splat_separator | DOTDOTDOT | parameter | macro_control

// NOTE: `macro_control` in parameter_item also accepts `{% %}` directly in `def`
// parameter lists (a syntax error in real crystal — only the `->()` proc form
// allows macro-generated parameters, verified 2026-09-14). Deliberate union:
// the grammar is context-insensitive and must accept all macro-branch texts
// (same precedent as `fun {{...}}` names, see docs/reports/wave-9-grammar.md). Harmless leniency.

private param_prefix ::= annotation_usage
                       | macro_control
                       | OUT

// Parameter name: a plain identifier or a keyword the real compiler accepts as
// a name (`of` as single name with default: `def self.map(values, of = nil, &)`,
// `for` as external name: `def f(for dst_io : IO)`, `when` as block param:
// `node.whens.each do |when|` — all stdlib shapes). Mirrors `bare_arg_name`.
// Declaration positions (COLON/ASSIGN/COMMA/RPAREN follow), so the keyword
// alternative fails fast elsewhere.
private param_name ::= IDENTIFIER | keyword_as_record_field

// Anonymous `out : Type` (lib fun shape — xml/libxml2.cr `fun xmlNewTextWriter(out : OutputBuffer*)`;
// verified legal; `def f(out : T)` is rejected by real crystal but tolerated here).
// FIRST alternative with no param_prefix*: the greedy prefix star would eat OUT
// and leave COLON dangling with no backtrack. Fails fast on `out x : T`
// (COLON absent → fall through to prefix+name alternatives). No pin: no commit.
parameter ::= OUT COLON type_reference [ASSIGN expression]
            | param_prefix* [STAR | DOUBLE_STAR | AMPERSAND] param_name instance_var_access [COLON type_reference] [ASSIGN expression]
            | param_prefix* [STAR | DOUBLE_STAR | AMPERSAND] param_name IDENTIFIER [COLON type_reference] [ASSIGN expression]
            | param_prefix* [STAR | DOUBLE_STAR | AMPERSAND] param_name [macro_interpolation] [COLON (splat_type | type_reference)] [ASSIGN expression]
            // Macro-splat parameter (`def initialize({{ x.map ... end.splat }})`
            // — macros.cr `record`): the whole parameter is generated code.
            // Before the external/internal-name pair (fails fast without
            // `{{`); kept inside `parameter` (not parameter_item) so the
            // PARAMETER_LIST shape and CrystalParameterMixin stay intact.
            // The `[STAR]` covers the splat-after-interpolation shape
            // (`{{operands.splat(", ")}}*, node : ASTNode?` —
            // interpreter/compiler.cr): the `*` applies to the generated
            // list, never a bare STAR param (which has no `{{`).
            | macro_interpolation [STAR]
            | param_prefix* [STAR | DOUBLE_STAR | AMPERSAND] instance_var_access [COLON type_reference] [ASSIGN expression]
            | param_prefix* [STAR | DOUBLE_STAR | AMPERSAND] class_var_access [COLON type_reference] [ASSIGN expression]
            | param_prefix* AMPERSAND class_var_access [COLON type_reference]
            | param_prefix* AMPERSAND COLON type_union (COMMA type_union)* ARROW [type_union]
            | param_prefix* AMPERSAND [COLON type_reference]
            | param_prefix* LPAREN IDENTIFIER (COMMA IDENTIFIER)* RPAREN
            | param_prefix* type_reference {
  mixin="io.github.unurgunite.crystal.psi.impl.CrystalParameterMixin"
}

// Splat element type (`*args : *T`, `**opts : **T`): the same STAR/DOUBLE_STAR
// prefix inside the annotation. Plain `x : **T` is a syntax error (verified),
// so this shape only appears after a splat/double-splat/block parameter name.
private splat_type ::= (STAR | DOUBLE_STAR) type_reference

private bare_splat_separator ::= STAR &(COMMA | RPAREN | NEWLINE)

// ==================== Property Declarations ====================

// Property-generating macros (`getter`, `setter`, `property`, `class_getter`, `class_property`,
// `class_setter`, optionally with a `?`/`!` suffix) take bare arguments of the form
// `name [: Type] [= default]`. They are method-call macros but written parenthesis-free, so they
// need a dedicated rule (a general bare-command `=` arg would wrongly swallow real assignments).
property_macro ::= property_macro_name (bare_property_arg (COMMA NLS bare_property_arg)* | bare_property_arg) [block] {pin=1}

private property_macro_name ::= "getter" | "getter?" | "setter" | "setter?" | "property" | "property?" | "class_getter" | "class_setter" | "class_property"

private bare_property_arg ::= [LPAREN] (IDENTIFIER | keyword_as_record_field | NEXT | SYMBOL_LITERAL) [COLON type_reference] [RPAREN] [ASSIGN expression]

property_declaration ::= (instance_var_access | class_var_access | IDENTIFIER | SELF DOT IDENTIFIER) COLON type_reference [ASSIGN expression]

// ==================== Visibility ====================

visibility_modifier ::= (PRIVATE | PROTECTED) (method_definition | macro_definition | class_definition | module_definition | struct_definition | enum_definition | record_definition | alias_definition | constant_assignment | property_macro | abstract_method_definition | statement)
                      | (PRIVATE | PROTECTED) SELF DOT IDENTIFIER [call_args | bare_argument_list] [block]
                      | (PRIVATE | PROTECTED) &NEWLINE

// ==================== Statements ====================

statement_list ::= statement_or_separator*

private statement_or_separator ::= NEWLINE | SEMICOLON | statement

// `when` can never start a statement (reserved word — a `when` at statement
// position is always a clause keyword of the enclosing case/select). The guard
// is load-bearing: `variable_reference` accepts WHEN for `|when|` block params
// (`puts when`, `when.body` — type_guess_visitor.cr), and without it a
// statement_list would swallow the next `when` clause as an expression
// statement (`when 0 then @x` broke with `got 'then'`; multi-when case/select
// collapsed into one clause).
statement ::= !WHEN (if_statement
            | unless_statement
            | while_statement
            | until_statement
            | begin_statement
            | for_statement
            | select_statement
            | return_statement
            | break_statement
            | next_statement
            | yield_statement
            | with_yield_statement
            | include_statement
            | extend_statement
            | multi_assignment
            | property_declaration
            | assignment
            | constant_assignment
            | macro_control
            | escaped_macro_statement
            | dot_space_statement
            | bare_command_space_first
            | bare_command_expression
            | method_definition
            | macro_definition
            | macro_definition_open
            | expression_statement)

expression_statement ::= expression [expression_assign_suffix [postfix_modifier] | postfix_modifier]

private expression_assign_suffix ::= assign_op NLS? (assignment | expression)

postfix_modifier ::= (IF | UNLESS | WHILE | UNTIL | RESCUE) expression [expression_assign_suffix]

// ==================== Control Flow ====================

if_statement ::= IF condition then_clause statement_list elsif_clause* [else_clause] END {pin=1}

unless_statement ::= UNLESS condition then_clause statement_list [else_clause] END {pin=1}

while_statement ::= WHILE condition then_clause statement_list END {pin=1}

until_statement ::= UNTIL condition then_clause statement_list END {pin=1}

condition ::= condition_assignment | expression

private condition_assignment ::= variable ASSIGN NLS expression

for_statement ::= FOR IDENTIFIER (COMMA IDENTIFIER)* IN expression then_clause for_body END {pin=1}

// `{% for %}` generating case branches (`case x {% for n in NS %} in .{{n.id}}? ...` —
// token.cr, tracing.cr): the loop body holds `in`/`when` clauses, macro controls,
// or raw argument text (`call(..., {% for i in 0...n %} arg{{i}}, {% end %})` —
// proc.cr: the generated args carry their own commas as flat tokens). The
// statement_list alternative stays FIRST (plain loops keep their shape; it also
// keeps a single getStatementList() on the generated PSI). The flat-token
// alternative commits only when a body line fails statement parsing — same PSI
// type via expression-free tokens (no new element types, no duplicate getters).
private for_body ::= statement_list | (expression | when_clause | in_clause | macro_control | macro_control_token)+

case_statement ::= CASE [assignment | expression] NEWLINE* (NEWLINE* (when_clause | in_clause | macro_control))+ [else_clause] END {pin=1}

begin_statement ::= BEGIN statement_list rescue_clause* [else_clause] [ensure_clause] END {pin=1}

select_statement ::= SELECT NEWLINE+ select_when_clause+ [else_clause] END

select_when_clause ::= WHEN statement then_clause statement_list

private then_clause ::= THEN | NEWLINE | SEMICOLON

elsif_clause ::= ELSIF condition then_clause statement_list

else_clause ::= ELSE statement_list

when_clause ::= WHEN case_pattern_list then_clause statement_list

// `when` patterns: plain expressions plus regex literals (`when /re/`).
// The `/` lexer rule emits REGEX_BEGIN only in operator position — exactly where
// a `when` pattern starts — so it can never be division here (`when a/b/` still
// parses as division through the expression alternative; PEG tries the regex
// first but backtracks on REGEX_END mismatch).
private case_pattern_list ::= case_pattern_alt (NLS COMMA NLS case_pattern_alt)*
private case_pattern_alt ::= regex_expression
                           | NLS DOT (IDENTIFIER | RESPONDS_TO | IS_A | NIL_QUESTION | AS | AS_QUESTION | CASE_EQ | operator_method_name | BANG) [call_args | bare_argument_list]
                           | case_pattern_assign
                           | expression

// Assignment inside `when` (`when a = f(x)` — the bound value is matched).
// PEG order: before `expression` so the ASSIGN is not left dangling.
private case_pattern_assign ::= variable ASSIGN NLS expression

// `in` pattern clauses (`case ... in Tuple(A, B)`, `in WinError`, `in {a, b}`,
// `in .{{name}}?` — disassembler.cr/interpreter.cr macro-generated receiver):
// full expression_list (not just call-shaped patterns), optional `if` guard.
// PEG order: tuple destructuring literal first so `{a, b}` is not read as a
// tuple_literal expression missing its `then`; DOT+`{{` last (fail-fast;
// plain forms keep their shapes — goldens confirm). No block tails anywhere:
// blocks never appear in patterns.
in_clause ::= IN tuple_literal [IF expression] then_clause statement_list
            | IN expression_list [IF expression] then_clause statement_list
            | IN DOT macro_interpolation [call_args | bare_argument_list] [IF expression] then_clause statement_list

rescue_clause ::= RESCUE [rescue_spec] then_clause statement_list

// rescue_spec: handles all Crystal rescue clause forms.
// Order matters in PEG (longer alternative first for IDENTIFIER disambiguation).
// type_reference supports unions (SomeError | OtherError) and namespaces (::Foo).
// Macro-interleaved specs (`rescue IO::Error{% unless win %} | OpenSSL::Error{% end %}`
// — http/server.cr): `{% %}` may sit between union members. The tail commits
// only on a following macro_control or PIPE+type (plain specs keep the single
// type_reference shape — goldens confirm); the union-inside-type_reference
// still wins for macro-free `A | B`.
private rescue_spec ::= IDENTIFIER COLON type_reference
                      | IDENTIFIER
                      | type_reference (NLS macro_control | NLS PIPE NLS type_reference)*

ensure_clause ::= ENSURE statement_list

return_statement ::= RETURN postfix_modifier
                   | RETURN assignment (COMMA NLS expression)* [postfix_modifier]
                   | RETURN expression? (COMMA NLS expression)* [postfix_modifier]
                   | RETURN {pin=1}

break_statement ::= BREAK postfix_modifier
                  | BREAK assignment (COMMA NLS expression)* [postfix_modifier]
                  | BREAK expression? (COMMA NLS expression)* [postfix_modifier]
                  | BREAK {pin=1}

next_statement ::= NEXT postfix_modifier
                 | NEXT assignment (COMMA NLS expression)* [postfix_modifier]
                 | NEXT expression? (COMMA NLS expression)* [postfix_modifier]
                 | NEXT {pin=1}

// `return`/`break`/`next` are also valid expressions in Crystal (e.g. `x || return nil`,
// `yield || break`). They appear as operands of `||`/`&&` and in argument position.
return_expression ::= RETURN assignment (COMMA NLS expression)*
                    | RETURN expression? (COMMA NLS expression)*

break_expression ::= BREAK assignment (COMMA NLS expression)*
                   | BREAK expression? (COMMA NLS expression)*

next_expression ::= NEXT assignment (COMMA NLS expression)*
                  | NEXT expression? (COMMA NLS expression)*

yield_statement ::= YIELD [LPAREN argument_list_macro RPAREN | bare_argument_list] [postfix_modifier] {pin=1}
// `yield` whose paren args contain a macro-generated tuple `{% for %}` body
// (`yield({elem, {% for %} other_elem{{i}}, {% end %}})` — enumerable.cr
// `zip`): the flat macro controls break argument_list's `argument (COMMA
// argument)*` rhythm (each `{%...%}` is a lone control with no commas).
// Same flat-token precedent as hash_entry_list/array: accept raw controls
// INSIDE the parens (no new PSI type — controls flatten as siblings;
// arity tooling reads the ARGUMENT leaves, of which there are exactly the
// real ones: `elem`, `other_elem{{i}}`). Commits only on `{%` right after
// `(` (fail-fast: plain `yield(x, y)` keeps argument_list shape — goldens
// confirm). The tail after the last control is a plain argument_list
// (trailing real args + `)`), so `yield({% for %}a,{% end %}b, c)` works.
private argument_list_macro ::= &MACRO_CONTROL_BEGIN (macro_control | argument | macro_control_token | COMMA | NEWLINE)+

yield_expression ::= YIELD [LPAREN NLS argument_list NLS RPAREN | expression (COMMA NLS expression)*] {pin=1}

with_yield_statement ::= WITH expression YIELD {pin=1}

// ==================== Assignments ====================

// Assignment targets: plain variables, plus call/index chains (`a.b`, `a[i]`,
// `a.b.c`, `a[i].b`) which Crystal allows with `=` and op-assign
// (`anchor = node.anchor ||= ...`, `c.w ||= 5`, chained `h["k"] = v = 1`).
// The call form comes first (PEG): it is strictly longer than `variable`.
// Chained DOT-call assignment (`point.x_ptr.value = 5.0`, `a.b.c = v`): the
// LONGEST assignable chain must win. The first segment needs its OWN rule that
// cannot swallow the following DOTs: `assignable_call`'s `dot_call_access` tail
// eats `.x_ptr.value` as call+bare-args with no backtrack, so the chained form
// below never matches. `assignable_head` = receiver + at most ONE suffix group
// (required: the chained form always has ≥2 DOTs, so the head's single group +
// explicit DOT + name covers exactly the greedy shape; plain `a.b = v` falls
// through to the second alternative with zero shape change — verified).
// NOTE: folded into `assignment` (not a separate statement alternative) so the
// generated CrystalAssignment PSI keeps its shape (inspections read
// CrystalStatement.assignment).
assignment ::= assignable_head DOT (IDENTIFIER | CONSTANT | keyword_as_method | INSTANCE_VAR | CLASS_VAR) (dot_call_access | namespace_access)* assign_op NLS? (assignment | expression) [postfix_modifier]
             | assignable_call assign_op NLS? (assignment | expression) [postfix_modifier]
             // Grouped-postfix receiver (`(stack - size).as(Int32*).value = type_id`
             // — instructions.cr `code:` hash entry): grouped_expression IS in
             // postfix_expression's primary tower, but the plain assignable
             // alternatives above can't start with it (PEG commits on the
             // receiver alternatives first and the group never matches). The
             // leading-`(` is disjoint from plain receivers (fail-fast), so
             // plain `a.b = v` keeps its shape — goldens confirm. The tail is
             // the shared chained form (DOT name + more DOTs + assign_op) so
             // `(a).b.c = v` chains work too. NOTE: optional trailing [block]
             // is NOT here — `foo.bar do end = x` is nonsense.
             | grouped_expression (dot_call_access | namespace_access)+ assign_op NLS? (assignment | expression) [postfix_modifier]
             | variable assign_op NLS? (assignment | expression) [postfix_modifier] {pin=2
  mixin="io.github.unurgunite.crystal.psi.impl.CrystalAssignmentMixin"
}

private assignable_call ::= (SELF | instance_var_access | class_var_access | GLOBAL_VAR | CONSTANT | IDENTIFIER | OUT) (dot_call_access | namespace_access | LBRACKET NLS [range_argument_list] RBRACKET [QUESTION])+

// Receiver + at most ONE suffix group, and that group must NOT be a DOT-call
// with its own args tail (see `assignment` chained form above): `.x_ptr` in
// `point.x_ptr.value` parses via the no-args DOT alternative, leaving `.value`
// for the explicit DOT + name. Index/namespace groups are unrestricted.
private assignable_head ::= (SELF | instance_var_access | class_var_access | GLOBAL_VAR | CONSTANT | IDENTIFIER | OUT) (DOT (IDENTIFIER | CONSTANT | keyword_as_method | INSTANCE_VAR | CLASS_VAR) | namespace_access | LBRACKET NLS [range_argument_list] RBRACKET [QUESTION])

multi_assignment ::= multi_assign_target COMMA NLS multi_assign_target_list ASSIGN NLS multi_assign_values [postfix_modifier]

private multi_assign_target_list ::= multi_assign_target (COMMA NLS multi_assign_target)*

// Macro-interpolated multi-assign target (`{{operand.var}}, ip = ...` —
// disassembler.cr `{% for %}` body): at expansion time the `{{...}}` becomes
// a plain identifier, so the line is a normal multi-assign. Bare `{{a}}, b
// = ...` at top level is a syntax error in real crystal (verified 1.21.0),
// but inside `{% for %}` it is legal — accepted here as context-insensitive
// union (same precedent as `fun {{...}}` names). Disjoint first token (`{{`)
// — plain targets keep their shapes (goldens confirm).
multi_assign_target ::= macro_interpolation
                      | STAR variable
                      | STAR UNDERSCORE
                      | assignable_call
                      | variable [COLON type_reference]
                      | UNDERSCORE
                      | LPAREN multi_assign_target COMMA multi_assign_target_list RPAREN

private multi_assign_values ::= expression (COMMA expression)*

constant_assignment ::= CONSTANT ASSIGN NLS expression [postfix_modifier] {
  pin=2
  stubClass="io.github.unurgunite.crystal.stubs.CrystalConstantAssignmentStub"
  mixin="io.github.unurgunite.crystal.psi.impl.CrystalStubbedConstantAssignmentImpl"
  implements="io.github.unurgunite.crystal.psi.CrystalNamedElement"
}

// `out` as an assignment target (`out = v.to_unsafe`, `out += 1` — slice/sort.cr;
// verified legal). Reads go through `variable_reference` (which also has OUT —
// needed for `out.copy_from(...)` / `out.value` receiver shapes in sort.cr).
private variable ::= instance_var_access | class_var_access | GLOBAL_VAR | IDENTIFIER macro_interpolation | IDENTIFIER | OF | UNION | TYPE | OUT | fresh_var

private assign_op ::= ASSIGN | PLUS_ASSIGN | MINUS_ASSIGN | STAR_ASSIGN | SLASH_ASSIGN
                    | OR_OR_ASSIGN | AND_AND_ASSIGN | CARET_ASSIGN | PERCENT_ASSIGN
                    | AMPERSAND_ASSIGN | PIPE_ASSIGN | DOUBLE_STAR_ASSIGN | DOUBLE_SLASH_ASSIGN
                    | LSHIFT_ASSIGN | RSHIFT_ASSIGN
                    | WRAP_PLUS_ASSIGN | WRAP_MINUS_ASSIGN | WRAP_STAR_ASSIGN | WRAP_DOUBLE_STAR_ASSIGN

// ==================== Expressions ====================

// Single-alternative ternary: the previous three-alternative shape
// (or_expression QUESTION expression COLON expression | or_expression QUESTION
// | or_expression) parsed or_expression up to THREE times per expression node
// (PEG retries the whole prefix on each failed alternative), i.e. O(3^depth)
// on nested expressions — 191s for a 2.5KB hash-in-do-block-in-hash file.
// The optional tail parses the prefix exactly once.
// NLS around the tail tokens: the `:` branch may start on the next line
// (`? from + X\n : (...) ? ...` — range/bsearch.cr:52), same NLS discipline
// as every other binary operator in this tower (OR_OR NLS, EQ NLS, ...).
expression ::= or_expression [QUESTION NLS expression NLS COLON NLS expression]

private or_expression ::= and_expression (OR_OR NLS and_expression)*

private and_expression ::= not_expression (AND_AND NLS not_expression)*

private not_expression ::= BANG not_expression | comparison_expression

// Comparison RHS reaches `not_expression` (not just `range_expression`):
// `a != !!b`, `a == !b` are legal Crystal (verified) but `!` never starts a
// `range_expression`, so the RHS `!` dangled (`restrictions.cr`, `method_lookup.cr`).
private comparison_expression ::= range_expression ((EQ | NEQ | LT | GT | LTE | GTE | SPACESHIP | CASE_EQ | MATCH_OP) NLS not_expression)*

private range_expression ::= [or_bitwise_expression] (DOTDOT | DOTDOTDOT) NLS [or_bitwise_expression]
                           | or_bitwise_expression

private or_bitwise_expression ::= xor_expression (PIPE NLS xor_expression)*

private xor_expression ::= and_bitwise_expression (CARET NLS and_bitwise_expression)*

private and_bitwise_expression ::= shift_expression (AMPERSAND NLS shift_expression)*

private shift_expression ::= additive_expression ((LSHIFT | RSHIFT) NLS additive_expression)*

private additive_expression ::= multiplicative_expression ((PLUS | MINUS | WRAP_PLUS | WRAP_MINUS) NLS multiplicative_expression)*

private multiplicative_expression ::= power_expression ((STAR | SLASH | DOUBLE_SLASH | PERCENT | WRAP_STAR) NLS power_expression)*

private power_expression ::= unary_expression ((DOUBLE_STAR | WRAP_DOUBLE_STAR) NLS unary_expression)*

private unary_expression ::= (PLUS | MINUS | UNARY_PLUS | UNARY_MINUS | TILDE | AMPERSAND | STAR | CARET | WRAP_NEG) unary_expression
                           | postfix_expression

private postfix_expression ::= primary_expression postfix_op*

private postfix_op ::= NLS DOT (AS | AS_QUESTION | IS_A) LPAREN type_reference RPAREN
                     | NLS dot_call_access [block]
                     | namespace_access
                     | LBRACKET NLS [range_argument_list] [assign_op NLS expression] RBRACKET [QUESTION !(NLS expression COLON)] [index_assign_suffix]
                     | NLS DOT (INSTANCE_VAR | CLASS_VAR)
                     | NLS DOT IDENTIFIER assign_op expression

// Index arguments may be open ranges (`a[1..]`, `a[..2]`, `a[1.., 2]`): the range
// rule already allows missing sides, but `argument` requires a full expression.
// Index arguments may be open ranges (`a[1..]`, `a[..2]`, `a[1.., 2]`): the range
// rule already allows missing sides, but `argument` requires a full expression.
// This wrapper accepts a bare range (or range + more args) in index position.
// PEG order: named first (fail-fast on missing COLON), then range (narrower),
// then general argument. `range_expression` would otherwise commit on the
// label of `a[pattern, options: options]` (csv.cr) and orphan the COLON with
// no backtrack. `argument` also covers ranges via its `expression` tail, but
// the dedicated `range_expression` must win so tooling keeps its shape
// (CrystalArgumentCountInspection reads CrystalArgument PSI).
// The ternary-in-index gap (`a[b ? c : d]` — time/tz.cr) IS fixed here (was
// open): `range_expression` commits on `b` and `?` dangles with no backtrack,
// so the ternary gets its own alternative FIRST. PEG order: named (fail-fast
// on missing COLON), ternary (commits only on a full `? ... : ...`), then
// range (narrower), then general argument. or_expression is exactly the
// ternary LHS (ternary lives only at `expression` level), so a partial match
// is impossible — `a[b?]` (`?` glued into the IDENTIFIER, no QUESTION token)
// and `a[b ? c]` (no COLON) fall through untouched (verified, goldens green).
// No new PSI type: reuses expression nodes (the COLON/QUESTION tokens + two
// expressions flatten like the `expression`-level ternary tail).
private range_argument_list ::= range_argument (NLS COMMA NLS range_argument)*
private range_argument ::= named_argument | index_ternary | range_expression !range_extends | argument
// Guard: a bare range_expression match is only complete if NO expression-tower
// operator follows that would extend it (`self[*foo(r, s) || return nil]?` —
// match_data.cr/array.cr/string.cr `def []?`: range commits on `*foo(r, s)`,
// stops at `||`, and RBRACKET mismatches with no backtrack into `argument`).
// Operators BELOW range level (|, ^, &, shifts, +-*/) are consumed INSIDE the
// range operands, so only tower operators ABOVE range level are listed here
// (||, &&, comparisons); on guard failure PEG falls through to `argument`,
// whose full expression tower re-parses (ranges included) — previously all
// such shapes failed entirely, so zero golden churn by construction.
// Deliberately EXCLUDED: ASSIGN (index-assign `a[i = 1]` rides the `[assign_op
// ...]` arm after the list — guarding it would break that working shape;
// verified) and QUESTION (partial `a[b ? c]` fails identically either way).
private range_extends ::= OR_OR | AND_AND | EQ | NEQ | LT | GT | LTE | GTE | SPACESHIP | CASE_EQ | MATCH_OP
private index_ternary ::= or_expression QUESTION expression COLON expression
// Bracketed type-label inside index/call brackets (`foo([value : Int64])` —
// interpreter instructions.cr operand descriptors): `[name : Type]` is a
// declaration tuple, not an index hash — `value` would commit as an
// expression and orphan `: Int64`. Commits only on `[`+name+COLON
// (fail-fast: `[a]`, `[a, b]`, `x[0]` never match — index shapes keep
// theirs, goldens confirm). Joins argument right after named_argument:
// both are colon-shaped — PEG tries named_argument first so `a[label: x]`
// named args still win (they fail fast on non-IDENTIFIER labels anyway).
private bracket_type_label ::= LBRACKET NLS bare_arg_name COLON type_reference NLS RBRACKET

// DOT-call access: the method-name + optional args part of a DOT-call (e.g. `.tanzen`,
// `.new(arg)`, `.method arg`). Non-private so it gets a real PSI composite with a
// CrystalDotCallAccessMixin providing getReference() — enables identifier highlighting
// and hover for DOT-calls (Apfel.tanzen, a.essen) through the same PsiReference
// mechanism as variable_reference. The DOT and method name are children of this composite;
// the receiver is the prevSibling in the flattened postfix_expression sequence.
// Type-cast form: .as(T) / .as?(T) / .is_a?(T) take a *type*, not an expression argument.
// Placed first so PEG prefers it over the generic call_args (which would try to parse T
// as an expression and fail on pointer types like `self*`).
// Setter-DOT RHS note: an `[ASSIGN (bare_command_expression | ...)]` tail on the
// main alternative was tried for `@c.last = phi t1, t2` (phi.cr) and REVERTED:
// any ASSIGN-tail lets the *previous* DOT-call's ASSIGN-branch swallow a
// following `.@ivar` as a bare arg with no backtrack (`other.value.@tail`
// broke; ConditionalAssignment golden). The phi.cr shape parses anyway via
// `assignment ::= assignable_call assign_op (assignment | expression)`
// (DOT_CALL + ASSIGN + EXPRESSION[BARE_COMMAND]) — verified by probe.
// `.@ivar` is a pure postfix access (verified with the real compiler:
// `a.@b = 1`, `a.@b(1)` are syntax errors) — no ASSIGN/args tail. The
// `.@ivar` alternative MUST precede the main alternative (PEG longer-first…
// here: first-match-wins): the main alternative's optional `[ASSIGN (...)]`
// tail commits on the earlier DOT (e.g. `.value` in `other.value.@tail`),
// swallows `.@tail` as a bare-command arg, and never backtracks — so with the
// old order `other.value.@tail` broke into `.value` + bare `.@tail`.
// `a.@b 1, 2` (bare args on ivar access) is also a syntax error: no args tail.
// The `!(INSTANCE_VAR | CLASS_VAR)` guard pins the main alternative off ivars:
// without it the ASSIGN-branch's bare-command RHS re-matches `.@tail` as a
// bare arg even with the split alternative above (PEG tries the main alt's
// ASSIGN tail before postfix_op* advances to the next DOT).
// PEG: the no-LBRACKET tail commits first — `parts[0]`-style index tails then
// attach via the regular postfix loop, which also accepts further DOT/index
// segments (`a.b[0].c`). Without the guard the DOT alternative swallows the
// index into a bare arg and orphans the rest (`parts[0], city: ...` broke into
// BARE_COMMAND + DUMMY_BLOCK; NamedTuple/CallAssignTargets goldens).
// SCOPE: the guard ONLY applies to the bare-argument tail (bare calls like
// `puts Foo.bar 123` — the shape the regression came from). The paren and
// bare-dot tails stay guard-free: `.should eq(true)` (DescribeBlock golden)
// parses through the DOT alternative with a paren-arg tail, and `a.b[0]`-style
// index tails ride the postfix loop, not dot_call arms.
// `.@ivar` EXCLUSION on the bare tail, generalized to ALL DOT-led tails:
// no DOT-led segment can start an expression in real crystal (verified:
// `f .upcase` formats to `f.upcase` — the DOT attaches as postfix chain),
// so a bare tail starting with DOT must fail and let postfix_op own it.
// (`other.value.@tail` stays flat siblings — ConditionalAssignment golden;
// `node.location.not_nil!, uninitialized` parses as 2 args, not nested —
// type_declaration_visitor.cr, verified with real crystal: `f(a.b!, c)` is
// 2 args.) `&.` shorthand is unaffected (AMPERSAND-led, not DOT-led).
// YIELD EXCLUSION (same phantom-arg hazard): `with SslConfig.new yield`
// (WithYield golden) — bare `yield` belongs to with_yield_statement, not to
// `.new`'s argument list. Precision `!(YIELD !LPAREN)`: `foo.bar yield(x)`
// keeps attaching (paren form can't be a with_yield tail); only the bare
// form is excluded. `foo.bar yield(x)` is unobserved in stdlib but stays
// working through this carve-out.
dot_call_access ::= DOT (AS | AS_QUESTION | IS_A) LPAREN NLS type_reference NLS RPAREN [ASSIGN]
                  | DOT AT macro_interpolation [ASSIGN] [call_args | !LBRACE bare_argument_list]
                  | DOT (INSTANCE_VAR | CLASS_VAR)
                  // Trailing `?` on index args (`headers["V"]?` — endless http
                  // shapes): the `?` binds the WHOLE index lookup, not the last
                  // inner arg (`foo["a"?]` would be nonsense). Without this the
                  // bare_argument_list swallows `["V"]` and the `?` dangles
                  // (j1/j13 minis). `!LBRACE` preserved (DescribeBlock guard);
                  // no QUESTION on the paren arm (`foo(x)?` is postfix `?`,
                  // handled by postfix_op/index_assign_suffix — untouched).
                  | DOT !(INSTANCE_VAR | CLASS_VAR) (interpolated_method_segment | IDENTIFIER | CONSTANT | keyword_as_method | macro_interpolation | BANG) [call_args | !LBRACE !DOT !(YIELD !LPAREN) bare_argument_list [QUESTION]] {
  mixin="io.github.unurgunite.crystal.psi.impl.CrystalDotCallAccessMixin"
}

// Space-paren DOT-call statement (`builder.icmp (a ? b : c), p1, p2` —
// codegen/primitives.cr:488): a DOT-call whose paren group is
// SPACE-separated from the callee, followed by a comma tail, so real crystal
// reads it as ONE call (`icmp` with 3 args — verified 1.21.0 with
// `crystal tool format --check`; the glued `builder.icmp(t ? A : B), p1, p2`
// is a SYNTAX ERROR there).
// STATEMENT LEVEL ONLY (same scoping as bare_command_space_first): the token
// stream is whitespace-blind, so `a.b(c), d` inside `foo(...)` is
// token-identical to the space form — but there the trailing `, d` belongs
// to the OUTER call (`foo` gets 2 args). An expression-reachable alternative
// would steal outer args with no backtrack (verified 2026-09-15: the
// COMMA-inside-parens scan idea fails because the comma sits AFTER the
// parens, not inside). At statement level a top-level comma has nowhere else
// to go, so greedy consume is safe. Glued single `foo.bar (1)` keeps
// method-call shape via bare_space_args' load-bearing COMMA lookahead.
// Receiver is a plain variable_reference (`builder` — the only stdlib shape;
// `a.b.c (x), y` chains stay a tolerated gap). The method name is a plain
// token (no reference — Go to Definition/hover degrade for this one shape;
// arity tooling ignores the new node type — one call site in stdlib).
// The args reuse bare_space_args (REAL bare_argument_list node, same
// duplicate-getter discipline as bare_command_space_first).
dot_space_statement ::= variable_reference DOT (IDENTIFIER | CONSTANT | keyword_as_method | macro_interpolation) bare_space_args [block]
// Macro-suffixed method segment (`LibLLVM.build_{{name}}2(...)` — llvm/builder.cr):
// IDENTIFIER + interpolation + optional trailing segment. PEG first (longer than
// bare IDENTIFIER); fails fast when no `{{` follows the identifier.
private interpolated_method_segment ::= IDENTIFIER macro_interpolation (IDENTIFIER | CONSTANT | INTEGER_LITERAL)?

// (REMOVED dot_space_call/space_paren_scan/for_like_tail_arg — replaced by
// dot_space_statement above. Trap record: (1) a COMMA-inside-parens scan
// misfires because the disambiguating comma sits AFTER the parens;
// (2) inlining argument/bare_argument wrappers beside scan leaves emits
// duplicate flat+wrapper getArgumentList()/getBareArgumentList() overload
// pairs on DOT_CALL_ACCESS that break javac — verified 2026-09-15 twice.)

// Namespace access: `::Const` in expression context (e.g. `Foo::Bar`, `::Foo`, `A::B::C`).
// Non-private so it gets a real PSI composite with a CrystalNamespaceAccessMixin providing
// getReference() — enables Go to Definition and hover for intermediate namespace segments
// (e.g. `Bar` in `Foo::Bar.baz`). The DOUBLE_COLON and CONSTANT are children of this
// composite; the preceding part of the namespace path is the prevSibling in the flattened
// postfix_expression sequence.
// The segment may be macro-generated (`Severity::{{severity}}` — at runtime a real
// constant); the mixin returns null without a CONSTANT child, so resolution degrades
// gracefully instead of failing the parse.
namespace_access ::= DOUBLE_COLON (CONSTANT | macro_interpolation) {
  mixin="io.github.unurgunite.crystal.psi.impl.CrystalNamespaceAccessMixin"
}

// Keywords that Crystal allows as method names after DOT
private keyword_as_method ::= ABSTRACT | ALIAS | ANNOTATION | AS | AS_QUESTION | ASM
                            | BEGIN | BREAK
                            | CASE | CLASS
                            | DEF | DO
                            | ELSE | ELSIF | END | ENSURE | ENUM | EXTEND
                            | FALSE | FOR | FORALL | FUN
                            | IF | IN | INCLUDE | INSTANCE_SIZEOF | IS_A
                            | LIB
                            | MACRO | MODULE
                            | NEXT | NIL | NIL_QUESTION
                            | OF | OFFSETOF | OUT
                            | POINTEROF | PREVIOUS_DEF | PRIVATE | PROTECTED
                            | RECORD | REQUIRE | RESCUE | RESPONDS_TO | RETURN
                            | SELECT | SELF | SIZEOF | STRUCT | SUPER
                            | THEN | TRUE | TYPEOF
                            | UNINITIALIZED | UNION | UNLESS | UNTIL
                            | VERBATIM
                            | WHEN | WHILE | WITH
                            | YIELD
                            | PLUS | MINUS | STAR | SLASH | PERCENT | DOUBLE_STAR
                            | EQ | NEQ | LT | GT | LTE | GTE | SPACESHIP
                            | LSHIFT | RSHIFT | AMPERSAND | PIPE | CARET | TILDE
                            | DOUBLE_SLASH

// ==================== Primary Expressions ====================

private primary_expression ::= grouped_expression
                             | type_receiver_expression
                             | macro_array_tail
                             | array_literal
                             | hash_literal
                             | tuple_literal
                             | proc_literal
                             | namespace_access
                             | method_call_expression
                             | bare_command_expression
                             | implicit_object_call
                             | literal
                             | instance_var_access
                             | class_var_access
                             | variable_reference
                             | typeof_expression
                             | sizeof_expression
                             | instance_sizeof_expression
                             | pointerof_expression
                             | offsetof_expression
                             | uninitialized_expression
                             | asm_expression
                             | macro_interpolation
                             | yield_expression
                             | macro_if_expression
                             | macro_control
                             | if_statement
                             | unless_statement
                             | case_statement
                             | begin_statement
                             | return_expression
                             | break_expression
                             | next_expression

// Trailing `rescue` modifier inside parens (`(Process.run(...) rescue nil)` —
// link.cr). Narrower than a full `postfix_modifier`: `(x) if y` keeps its
// statement-level postfix shape (verified legal — must not reshape goldens).
// If/unless/while/until modifiers INSIDE parens (`(DEFAULT if
// supports_feature?(...))` — io_uring.cr:190 named-arg value): same legality,
// verified with real crystal 1.21.0. Separate arm AFTER rescue (rescue keeps
// its shape — link.cr golden untouched); flattens inline (no POSTFIX_MODIFIER
// node — same as the rescue arm). Fails fast without the keyword (goldens
// confirm zero churn).
// Statement SEQUENCES in parens (`(a; b)` — primitives.cr:746 ternary
// branches): real crystal allows `;`-separated statements inside any group
// (verified 1.21.0). The sequence sits INSIDE the group only (a new private
// rule would reshape every grouped_expression's PSI — GROUPED_EXPRESSION is
// read by tooling — so it inlines as `(SEMICOLON expression)*`: plain
// single-expression groups keep their shape, goldens confirm).
grouped_expression ::= LPAREN NLS expression (SEMICOLON NLS expression)* [assign_op NLS expression] [RESCUE expression] [(IF | UNLESS | WHILE | UNTIL) expression [expression_assign_suffix]] NLS RPAREN

// Index assignment on the LHS: `a[i] += v`, `a[i] ||= v`, `a[i], b = ...`.
// The `[]` postfix already parses `a[i]` as an index expression; this suffix
// turns it into an assignment target (also covers safe-navigation `a[i]? = v`).
private index_assign_suffix ::= [QUESTION] assign_op NLS? (assignment | expression)

// Bare (parenthesis-free) command calls such as `puts "x"`, `describe X do ... end`,
// or `get "/path" do ... end` are intentionally NOT part of `method_call_expression`
// (the recursive expression tower). A bare command's argument list is itself parsed by
// the full expression tower, which previously let the backtracking parser explore an
// exponential number of argument-groupings and hang on deeply nested inputs (IDE-freeze
// bug). Keeping the bare-command form at the statement level only breaks that cycle: it
// can no longer be reached from inside an expression, so no infinite/explosive mutual
// recursion occurs. The `!LPAREN !DOT !LBRACKET !binary_op_lookahead` lookahead prevents
// a parenthesised call like `add("x")` from being greedily consumed as a bare command
// (the command `add` with the grouped-expression argument `("x")`).
// Space-separated leading groups/arrays (`foo (1), 2`, `foo [1], 2` — verified
// legal; time/format/formatter.cr, codegen/primitives.cr, syntax/ast.cr shapes):
// a grouped/array first argument followed by a comma proves the SPACE form (a
// glued `foo(1)` never has a comma after `)`). STATEMENT LEVEL ONLY (see
// bare_command_space_first below): the bare tower has no whitespace tokens, so
// `a[n], b` (index + next value) is token-identical to `a [n], b` (space call)
// and an expression-reachable alternative steals index expressions with no
// backtrack (`a[n], a.value` multi-RHS and `{street: parts[0], ...}` hash values
// both broke into BARE_COMMAND; CallAssignTargets/NamedTuple goldens).
// `new [name], global` rides the statement-level alternative (`new` lexes
// as IDENTIFIER, verified; it is a def-body tail statement in ast.cr).
// YIELD-FIRST-ARG EXCLUSION: `with config yield` (WithYield golden) — a bare
// `yield` first arg belongs to with_yield_statement, not to the bare command
// (`config` + phantom `yield` arg, with_yield's own YIELD then missing).
// Precision `!(YIELD !LPAREN)`: `foo yield(x)` keeps working (paren form
// can't be a with tail). Non-first `, yield` args are unaffected
// (`add_type all_types, yield(obj)` — type_merge.cr — the guard only sees
// the list head).
// BLOCK `||`/`&&` CONTINUATION (`index { |e| yield e } || raise E.new` —
// enumerable.cr:763; `bsearch { } || return`, `find { } || ...`): the arg-less
// `| block` arm bypasses bare_or_expression (which consumes `||` inside
// arguments — `foo bar || baz` works), so a block-terminated bare command
// left `||` dangling. The tail re-attaches it. Precision: OR_OR/AND_AND only
// (all other binary ops are blocked by binary_op_lookahead or consumed
// in-args); RHS is full `expression` (covers `raise X`, bare `return`,
// calls — return/yield/raise are all in the tower). Fires only after a
// block — arg-internal `||` is consumed greedily first, so `foo bar || baz`
// keeps its shape (goldens confirm).
// `!COLON` right after the callee: `big_i: {{ x }} - other` is a hash label,
// not a call — the COLON-led shape must fall through to variable_reference /
// hash parsing instead of becoming callee `big_i` + phantom `: ...` error
// (big_int.cr). `::` lexes as DOUBLE_COLON (not COLON), so `::X`/namespaces
// unaffected; `foo bar: 1` unaffected (COLON not adjacent to the callee).
bare_command_expression ::= [DOUBLE_COLON] (IDENTIFIER | CONSTANT | SELECT | UNION) !COLON !LPAREN !DOT !LBRACKET !binary_op_lookahead !bare_assign_lookahead !(YIELD !LPAREN) (bare_argument_list [block] | block) [(OR_OR | AND_AND) NLS expression] [postfix_modifier]
                          | (SUPER | PREVIOUS_DEF) !LPAREN !bare_assign_lookahead (bare_argument_list | block) [postfix_modifier]
                          | macro_callee_call [block] [postfix_modifier] {
  mixin="io.github.unurgunite.crystal.psi.impl.CrystalMethodCallExpressionMixin"
}

// A bare command (shell-style `cp a b`) never contains a top-level `=` assignment among its
// arguments; method-call macros like `property name : Type = default` / `getter foo = bar` do.
// Exclude the bare-command interpretation when such an `=` is present so def-macro calls win.
// `&.` shorthand calls (`&.to_s`, `&.==(2)`, `&.foo 1, 2`) also take bare-style trailing
// arguments (`each &.to_www_form builder, name`), so the callee tolerates them.
private bare_assign_lookahead ::= &( (!ASSIGN !NEWLINE ANY_TOKEN)* ASSIGN )

// Space-first bare call: `foo (1), 2`, `foo [1], [2]`, `new [name], global`.
// STATEMENT LEVEL ONLY (referenced solely from `statement`): at expression
// level the token stream cannot tell `a[n], b` (index + next value) from
// `a [n], b` (space call), and PEG never backtracks — an expression-reachable
// alternative stole both shapes (verified 2026-09-14, then scoped here).
// Same BARE_COMMAND_EXPRESSION PSI + mixin as the plain form (one
// getBareArgumentList() accessor: bare_space_args wraps a REAL
// bare_argument_list node — an inline `(grouped|array) (COMMA bare_argument)+`
// sequence makes GrammarKit emit a duplicate flat+wrapper overload pair that
// breaks javac; tried 2026-09-14).
bare_command_space_first ::= [DOUBLE_COLON] (IDENTIFIER | CONSTANT | SELECT | UNION) !binary_op_lookahead bare_space_args [block] [postfix_modifier] {
  mixin="io.github.unurgunite.crystal.psi.impl.CrystalMethodCallExpressionMixin"
}

// Space-first args: grouped/array first value + comma tail, wrapped in a REAL
// bare_argument_list node (so the BARE_COMMAND_EXPRESSION PSI keeps exactly
// one getBareArgumentList() accessor shape — no duplicate overloads). The
// COMMA inside the lookahead is load-bearing: without it the alternative
// steals single `foo (1)` / `foo [1]` (which must stay method-call/index
// shapes — goldens). The first element re-parses as a full bare_argument
// whose expression happens to be grouped/array; the plain statement-level
// alternative's !LPAREN/!LBRACKET guards are disjoint, so no PEG hazard.
// NOTE: bare_space_args inlines bare_argument_list directly (a named wrapper
// would flatten the same but add a useless PSI level; an inline
// `(grouped|array) (COMMA bare_argument)+` sequence makes GrammarKit emit the
// flat+wrapper getBareArgumentList() overload pair that breaks javac).
// POSTFIX after the leading group/array (`write_extra_newlines
// (last_entry.value || entry.value).end_location, entry.value.location` —
// syntax/to_s.cr:228): the first arg is grouped/array PLUS postfix
// (`.end_location`), so the lookahead allows bare_postfix_op* before the
// COMMA. Still load-bearing COMMA (single `foo (1)` / `foo (1).x` stay
// method-call shapes). No new ambiguity: after `(x)` only postfix tokens can
// follow in the lookahead, and a trailing COMMA proves the SPACE form —
// `foo (x)[a, b]` (index, no tail comma) still fails the lookahead because
// the postfix alternative atomically consumes `[a, b]` and the COMMA then
// mismatches (PEG backtracks the star to empty, COMMA mismatches `[`).
private bare_space_args ::= &((grouped_expression | array_literal) bare_postfix_op* COMMA) bare_argument_list

// Space-paren DOT-call (`builder.icmp (a ? b : c), p1, p2` — primitives.cr):
// a DOT-call whose paren args are SPACE-separated from the callee and hold
// ≥2 comma-separated values, so real crystal reads it as ONE call (`icmp`
// with 3 args — verified 1.21.0). The glued `foo(1), 2` form never has a
// comma inside the parens, so COMMA-inside-parens is the disambiguator
// (single `foo (1)` keeps method-call shape — goldens confirm). Same PSI as
// bare_command_space_first (BARE_COMMAND_EXPRESSION + real
// bare_argument_list). Commits only when a comma sits at paren depth 1:
// `foo (a ? b : c)` (ternary colon, no comma) stays a call (zero churn).
// (REMOVED — replaced by dot_space_call above: inlining the tail into
// dot_call_access collided accessors. History kept for the trap record:
// reusing argument/bare_argument wrappers beside the scan leaves emits
// duplicate flat+wrapper getArgumentList()/getBareArgumentList() overload
// pairs on DOT_CALL_ACCESS that break javac — verified 2026-09-15 twice.)

method_call_expression ::= type_path call_args [block]
                         | [DOUBLE_COLON] (IDENTIFIER | CONSTANT | SELECT | RESPONDS_TO | IS_A | NIL_QUESTION) call_args [block]
                         | (IDENTIFIER | CONSTANT) block
                         | (SUPER | PREVIOUS_DEF) call_args [block]
                         | (SUPER | PREVIOUS_DEF) bare_argument_list
                         | (SUPER | PREVIOUS_DEF) block {
  mixin="io.github.unurgunite.crystal.psi.impl.CrystalMethodCallExpressionMixin"
}

// Prevent bare_argument_list from consuming binary operators followed by expression-starting
// tokens as bare unary expressions. Without this, "width + height" is parsed as method call
// "width(+height)" instead of the binary expression "width + height".
// Also blocks *, /, % etc. so that "x * scalar" inside parenthesized calls is not
// misparsed as bare method call "x" with arguments "* scalar".
// Covers all expression-starting tokens: identifiers, constants, literals, vars, group/array/hash
// literals, percent literals, heredocs, commands, regex, and macro interpolation.
// Tradeoff: bare calls with splat like "add *args" need parentheses: "add(*args)".
private binary_op_lookahead ::= (PLUS | MINUS | STAR | SLASH | DOUBLE_SLASH | PERCENT | DOUBLE_STAR)
                               (IDENTIFIER | CONSTANT | STRING_LITERAL | INTEGER_LITERAL | FLOAT_LITERAL | CHAR_LITERAL
                               | SYMBOL_LITERAL | NIL | TRUE | FALSE | SELF | SUPER | PREVIOUS_DEF
                               | INSTANCE_VAR | CLASS_VAR | GLOBAL_VAR
                               | LPAREN | LBRACKET | LBRACE
                               | PERCENT_LITERAL_BEGIN | PERCENT_SYMBOL_BEGIN
                               | HEREDOC_START | COMMAND_BEGIN | REGEX_BEGIN | MACRO_INTERPOLATION_BEGIN)

// Implicit object call: .method, .method(args), or .[index] (used in &.foo shorthand and case/when patterns).
// `&.` may also carry bare-style trailing arguments (`each &.to_www_form builder, name`),
// so the callee tolerates an optional bare_argument_list without parens.
// `!` is a valid zero-arg DOT method (`x.!`, `&.empty?.!`); `?` is not (`x.?` is a syntax error).
// The name set is `keyword_as_method` (superset of the old ad-hoc list): `&.` accepts
// keyword methods (`a.try(&.def)`, `a.try(&.when)`, `a.try(&.annotation(x))` — all stdlib).
// No `macro_interpolation` in the name set by design: leading-dot `{{...}}` as a
// bare argument is a syntax error in real Crystal (`foo .{{x}}`, `foo(&.{{x}})` —
// both rejected with "expecting IDENT, ... (not '{{')", verified 2026-09-14), yet
// with the interpolation alternative the bare tower stole DOT-postfixes with no
// backtrack: `{{a}}.{{b}}` became BARE_COMMAND(callee `{{a}}`, arg `.{{b}}`)
// instead of a flat postfix (MacroSetter golden). `{{a}}.{{b}}` chains still parse
// via the expression tower (primary `{{a}}` + postfix dot_call `.{{b}}`).
// INSTANCE_VAR / CLASS_VAR stay: `a.try(&.@x)` is legal (verified 2026-09-14).
// Index tail (`&.pos[name]?` — filters.cr ×6, types.cr, fun.cr, to_s.cr):
// the `?` binds the whole index lookup. The tail sits BETWEEN call_args and
// bare_argument_list (not after): real crystal reads glued `&.foo[0]` as
// INDEX on the result (verified 1.21.0: `o &.foo[0]` → `x.foo[0]`), while
// spaced `&.foo [1, 2]` is an ARRAY argument (verified: "undefined method
// 'foo'" — i.e. `x.foo([1,2])`). The token stream is whitespace-blind, so
// one order must win: index-first matches 7 stdlib sites; the spaced-array
// shape has ZERO stdlib occurrences (tolerated gap — `&.foo [1,2]` now
// parses `[1,2]` as index args, arity-identical anyway). PEG commits the
// index tail only on a full `[...]` (fail-fast otherwise — plain `&.foo`
// and `&.foo(x)` keep their shapes, goldens confirm).
implicit_object_call ::= DOT (AS | AS_QUESTION | IS_A) LPAREN NLS type_reference NLS RPAREN
                       | DOT (IDENTIFIER | CONSTANT | keyword_as_method | INSTANCE_VAR | CLASS_VAR | CASE_EQ | operator_method_name | BANG) [call_args] (LBRACKET NLS [range_argument_list] RBRACKET [QUESTION])* [bare_argument_list] [block]
                       | DOT LBRACKET NLS [range_argument_list] RBRACKET [QUESTION] [assign_op expression]

call_args ::= LPAREN NLS argument_list NLS RPAREN
            | LPAREN NLS RPAREN

argument_list ::= (macro_arg_splice | argument | macro_control) (NLS COMMA NLS (macro_arg_splice | argument | macro_control))* [NLS COMMA]

argument ::= STAR expression
           | SPLAT expression
           | DOUBLE_STAR expression
           | AMPERSAND expression
           | OUT (IDENTIFIER | instance_var_access)
           | named_argument
           | and_assign_argument
           | bracket_type_label
           | macro_control
           | expression

// `{% for %}` / `{% if %}` splicing whole argument sequences (`call(*args,
// {% for i in 0...n %} arg{{i}}, {% end %})` — proc.cr:145): the header and
// footer are separate macro_controls with raw arg text between (no comma after
// the header), so the splice consumes header + newline-separated body items
// (each iteration's trailing comma belongs to the outer list loop).
// Transparent (private): control-free lists commit through `argument` exactly
// as before (goldens confirm zero shape change). `+` (not `*`) keeps lone
// `{% if x %}` controls on the plain macro_control alternative.
private macro_arg_splice ::= macro_control (NLS (argument | macro_control))+

// `{% for %}` / `{% if %}` generating whole arguments inside call args
// (`call(*args, {% for i in 0...n %} arg{{i}}, {% end %})` — proc.cr): the loop
// body holds raw argument text, so controls are valid argument *sequence*
// members alongside real arguments. Transparent (private): the control-free
// case commits through `argument` exactly as before (goldens confirm zero
// shape change). The loop's own inner commas are flat macro_control_token
// text — each generated arg ends with a comma the control body consumed.

// `&&=`/`||=` as an argument value (`m(x &&= 5, 1)` — real call sites).
// PEG order: before `expression` so the assign-op is not left dangling.
private and_assign_argument ::= variable (AND_AND_ASSIGN | OR_OR_ASSIGN) NLS expression

// Named argument: requires both name and COLON to match before committing.
// The name may be a keyword (`for: STDIN`, `in: 1`, `of: 2` — real call sites;
// process.cr `exec_stdio_to_fd(input, for: STDIN)`). Mirrors `bare_arg_name`
// below, which already accepts `keyword_as_record_field` for bare labels.
// Without pin=2, the optional [IDENTIFIER COLON] prefix would greedily consume
// IDENTIFIER even when COLON doesn't follow, causing binary expressions like
// x * 2 to be misparsed (x consumed, * 2 treated as unary star expression).
// Macro-interpolated name (`{{ key.id.stringify }}: %var{key.id}` —
// json/from_json.cr, yaml/from_yaml.cr `NamedTuple.new(...)` bodies):
// the label is macro-generated so the parser cannot see an IDENTIFIER.
// Disjoint first token (`{{`) — plain `name:` keeps its shape exactly
// (goldens confirm). Joins the name group (not a separate alternative)
// so the pin=2 error-recovery contract is unchanged.
private named_argument ::= (macro_interpolation | IDENTIFIER | keyword_as_record_field) COLON NLS? (macro_arg_splice | macro_control | decl_type_value | expression) {pin=2}

// Declaration-shaped value (`thread_local(x : ::Foo(Bar*))` — object.cr macro
// takes a TypeDeclaration, not an expression; bare twin `buf : UInt8*` in
// `::Syscall.def_syscall` — syscall.cr). PEG trap: `expression` PARTIALLY
// matches the type (`::Foo` then dangles at `(`) with no backtrack from the
// caller level, so the type path must be tried FIRST — but only when the
// value is type-only. The complexity guard commits solely when a type-only
// marker (`::`, `(`, `[`, `*`, `->`, `?`) appears before the value ends:
// plain `x: Int32` / `x: y` keep the expression shape (zero golden churn).
// The trailing terminator guard rejects partial matches (`x: a * b`,
// `x: cond ? a : b` fall through to expression). No pin anywhere inside:
// both guards fail cleanly with no input consumed.
private decl_type_value ::= decl_complex_scan type_reference &decl_paren_end
// Lookahead terminator WITHOUT leading NLS: `&(NLS MARKER)` is a trap —
// NLS possessively eats the very newline that IS the marker (`x : UInt8*\n)`
// fails: NLS eats `\n`, RPAREN mismatches, no retry with empty NLS).
// A pure token alternation suffices (lookahead never consumes: any NLS run
// is accepted at its FIRST newline; `,`/`)` match directly).
private decl_paren_end ::= COMMA | RPAREN | NEWLINE | SEMICOLON
// The scan loop EXCLUDES every marker token (same discipline as
// bare_assign_lookahead): a `(... ANY_TOKEN)* MARKER` loop would otherwise
// swallow the marker itself (`UInt8*` — STAR eaten as ANY_TOKEN, then the
// MARKER check fails on `,` with no backtrack into fewer iterations).
// `+` (not `*`): the marker must not be first (`(a)` grouped values,
// `*args` splats, `->` procs stay on the expression path — zero churn).
// DOUBLE_COLON is neither excluded nor a marker: `A::B` values scan through
// with no marker found (expression-namespace shape, zero churn), while
// `::Foo(Bar*)` still fires via LPAREN.
// CONCRETE tokens (not ANY_TOKEN): GrammarKit hoists `nextTokenIs(ANY_TOKEN)`
// as a first-token predicate for bare `(...)+ MARKER` sequences — and
// ANY_TOKEN (`new CrystalTokenType("ANY_TOKEN")`) never equals a real token,
// so the hoist is always-false and the whole scan is DEAD (verified
// 2026-09-15 with a stderr probe: first-iter=false on `UInt8`). Concrete
// tokens hoist correctly (nextTokenIs(IDENTIFIER|...) is true at type starts).
// The `&(...)` wrapper (same as bare_assign_lookahead) is kept; the caller
// references the scan BARE (nested _AND_-in-_AND_ never fires — verified).
// Loop set = tokens that occur INSIDE type text; markers = tokens that prove
// a type Suffix follows (pointer `*`, args `(`, nullable `?`, proc `->`).
// PIPE is neither (would steal `a | b` binary-or — the terminator guard
// can't save it since `)` follows both). LBRACKET/RBRACKET/INTEGER ride the
// loop (index brackets `[16]`) but `[` is NOT a marker (`a[0]` index values
// must stay expressions). DOT rides the loop (harmless: garbage like `a.b`
// still fails at type_reference/terminator).
private decl_complex_scan ::= &((IDENTIFIER | CONSTANT | DOUBLE_COLON | DOT | LBRACKET | RBRACKET | INTEGER_LITERAL | FLOAT_LITERAL)+ (LPAREN | STAR | DOUBLE_STAR | ARROW | QUESTION))

// Bare (parenthesis-free) arguments — used for calls like: describe App5 do ... end
// Arguments may continue on following lines after a comma (`printf "%s",\n  a` —
// real call sites); each continuation line holds one more argument.
bare_argument_list ::= bare_argument (COMMA NLS bare_argument)*

bare_argument ::= named_bare_argument
                | STAR bare_expression
                | SPLAT bare_expression
                | DOUBLE_STAR bare_expression
                | AMPERSAND bare_expression
                | macro_control
                // OUT-prefix BEFORE bare_expression: `foo(out x)` must match the
                // prefix form — bare_expression would otherwise consume lone `out`
                // (OUT is in variable_reference) and orphan `x` with no backtrack.
                 | OUT (IDENTIFIER | instance_var_access)
                 | bare_expression

// Space-first leading value: the grouped/array first argument. Inlined into the
// bare_command alternative above (a named wrapper rule would flatten children
// the same way — GrammarKit inlines single-child privates — so there is no
// point in a separate rule; the duplicate-getter breakage it caused is
// documented here as a warning, not a pattern).

// NOTE: no `::`-led positional bare alternative here by design. A previous
// revision added `bare_namespace_value ::= namespace_access [dot_call_access]`
// as a trailing `bare_argument` alternative and it let `bare_command_expression`
// steal `CONSTANT::...` tails (`NamespaceAccess::Inner.inner_method`,
// `@buffer = IO::Memory.new`, `"#{Foo::Bar.method}"` all regressed to
// BARE_COMMAND shape): after the CONSTANT callee, the `::...` remainder
// suddenly parsed as a bare argument. Leading-`::` values are only valid in
// the named-arg value position below (after `name COLON`), which cannot steal
// because the COLON anchor precedes the value.

// Named bare argument: requires both name and COLON to match before committing.
// The name may be a keyword (`def: a_def`, `in_macro: false` — real call sites
// pass `def`/`in`/`class` etc. as labels; verified with the real compiler).
// Without pin=2, the optional prefix would greedily consume
// IDENTIFIER even when COLON doesn't follow, causing binary expressions like
// x * scalar to be misparsed (x consumed, * scalar treated as unary star).
private named_bare_argument ::= bare_arg_name COLON named_bare_value [ASSIGN bare_expression] {pin=2}
// Grouped-expression values (`code: (stack - size).as(X*).value = tid` —
// instructions.cr): the `(` must commit before the bare-expression arm eats
// `stack` and orphans the operator. NOT a separate named_bare_argument
// alternative (that splits one BARE_ARGUMENT into two rule variants and
// breaks the pin contract — verified: BareNamespaceValue/KeywordBareLabels
// regressed): the grouped arm is FIRST inside named_bare_value (PEG
// longer-first within the rule). The `= tid` tail belongs to the OUTER
// named_bare_argument [ASSIGN ...], not here — no inner ASSIGN.
 private named_bare_value ::= grouped_named_value | decl_bare_type_value | namespace_access bare_postfix_op* | bare_expression
private grouped_named_value ::= grouped_expression bare_postfix_op*

// Bare-call label: plain identifier or any non-reserved keyword usable as a label.
private bare_arg_name ::= IDENTIFIER | keyword_as_record_field

// Named-arg value: leading-`::` namespaces (`level: ::Socket::Protocol::TCP`)
// are not valid `bare_expression` (the bare tower has no leading-`::` primary
// by design — it would let `bare_command_expression` steal `CONSTANT::...`
// tails, see NOTE above), so they get their own alternative. A single
// `namespace_access` is one `::Segment`; chains ride `bare_postfix_op*`
// (which includes `namespace_access`), mirroring how `postfix_expression`
// builds `::A::B::C` in expression context — flat NAMESPACE_ACCESS siblings.
// The COLON anchor precedes the value, so this cannot steal tails the way a
// positional alternative could. Plain values never start with `::`, so the
// first alternative fails fast with no shape changes elsewhere.
// Declaration-shaped values (`buf : UInt8*` — syscall.cr `def_syscall` bare
// macro args) ride the guarded decl_bare_type_value: same complexity +
// terminator discipline as the paren twin above, with bare terminators
// (COMMA / line end / block / postfix modifier — the value is paren-free).
private decl_bare_type_value ::= decl_bare_complex_scan type_reference &decl_bare_end
// Same no-NLS discipline as decl_paren_end above (the `&(NLS MARKER)` trap
// bites here hardest: bare values END at newlines by definition).
private decl_bare_end ::= COMMA | NEWLINE | SEMICOLON | DO | LBRACE | IF | UNLESS | WHILE | UNTIL | RESCUE | RPAREN | END
// Same concrete-token discipline as decl_complex_scan above (loop tokens +
// markers, `&(...)` wrapper, caller references the scan BARE).
private decl_bare_complex_scan ::= &((IDENTIFIER | CONSTANT | DOUBLE_COLON | DOT | LBRACKET | RBRACKET | INTEGER_LITERAL | FLOAT_LITERAL)+ (LPAREN | STAR | DOUBLE_STAR | ARROW | QUESTION))

// Bare expression: same as expression but does not consume blocks or assignments
// This prevents the bare argument from eating the 'do' that belongs to the outer method call
// Same single-alternative shape as `expression` (see above): the old
// three-alternative form triple-parsed every bare expression node.
private bare_expression ::= bare_or_expression [QUESTION NLS expression NLS COLON NLS expression]

private bare_or_expression ::= bare_and_expression (OR_OR NLS bare_and_expression)*

private bare_and_expression ::= bare_not_expression (AND_AND NLS bare_not_expression)*

private bare_not_expression ::= BANG bare_not_expression | bare_comparison_expression

private bare_comparison_expression ::= bare_range_expression ((EQ | NEQ | LT | GT | LTE | GTE | SPACESHIP | CASE_EQ | MATCH_OP) NLS bare_not_expression)*

private bare_range_expression ::= [bare_or_bitwise_expression] (DOTDOT | DOTDOTDOT) NLS [bare_or_bitwise_expression]
                                | bare_or_bitwise_expression

private bare_or_bitwise_expression ::= bare_xor_expression (PIPE NLS bare_xor_expression)*

private bare_xor_expression ::= bare_and_bitwise_expression (CARET NLS bare_and_bitwise_expression)*

private bare_and_bitwise_expression ::= bare_shift_expression (AMPERSAND NLS bare_shift_expression)*

private bare_shift_expression ::= bare_additive_expression ((LSHIFT | RSHIFT) NLS bare_additive_expression)*

private bare_additive_expression ::= bare_multiplicative_expression ((PLUS | MINUS | WRAP_PLUS | WRAP_MINUS) NLS bare_multiplicative_expression)*

private bare_multiplicative_expression ::= bare_power_expression ((STAR | SLASH | DOUBLE_SLASH | PERCENT | WRAP_STAR) NLS bare_power_expression)*

private bare_power_expression ::= bare_unary_expression ((DOUBLE_STAR | WRAP_DOUBLE_STAR) NLS bare_unary_expression)*

private bare_unary_expression ::= (PLUS | MINUS | UNARY_PLUS | UNARY_MINUS | TILDE | AMPERSAND | STAR | WRAP_NEG) bare_unary_expression
                                | bare_postfix_expression

private bare_postfix_expression ::= bare_primary_expression bare_postfix_op*

private bare_postfix_op ::= NLS DOT (AS | AS_QUESTION | IS_A) LPAREN type_reference RPAREN
                         | NLS dot_call_access
                         | namespace_access
                         | LBRACKET NLS [range_argument_list] [assign_op NLS expression] RBRACKET [QUESTION !(NLS expression COLON)] [index_assign_suffix]

// Bare primary: like primary but no blocks or method calls with bare args (to prevent ambiguity).
// The nested-bare alternative (`exec new_request method, path, headers, body` —
// http/client.cr) sits LAST and commits only when a comma-separated tail
// follows the inner callee's first argument: without the COMMA lookahead it
// would steal single-arg outers (`foo bar` must stay callee+variable, not
// callee+(bare `bar`)). The inner form reuses the statement-level
// bare_command_expression (same PSI shape, no new element types). Recursion
// always consumes ≥1 callee token per level, so PEG terminates.
// The COLON variant covers a NAMED first inner arg (`set_visibility
// parse_var_or_call global: true, location: location` — parser.cr:5099):
// greedy right-association (`o f x: 1` == `o(f(x: 1))`) verified with real
// crystal 1.21.0. `foo bar: 1` still parses as outer+ named arg: the guard
// fires, inner `bar: 1` fails (no args after callee `bar`), PEG backtracks
// to the plain alternatives.
private bare_primary_expression ::= &(IDENTIFIER IDENTIFIER (COMMA | COLON)) bare_command_expression
                                  | grouped_expression
                                  | type_receiver_expression
                                  | macro_array_tail
                                  | array_literal
                                  | hash_literal
                                  | tuple_literal
                                   | proc_literal
                                  | bare_method_call_expression
                                  | implicit_object_call
                                  | regex_expression
                                  | literal
                                  | instance_var_access
                                  | class_var_access
                                  | variable_reference
                                  | typeof_expression
                                  | sizeof_expression
                                  | instance_sizeof_expression
                                  | pointerof_expression
                                  | offsetof_expression
                                  | uninitialized_expression
                                  | asm_expression
                                  | macro_interpolation
                                  | return_expression
                                  | break_expression
                                  | next_expression
                                  | yield_paren_expression
                                  | yield_bare_multiarg

// `yield` as a grouped bare value (`(yield a, self[b])` — named_tuple.cr
// `map` macro body): inside the flat macro_array_tail alternatives the bare
// `expression` arm commits on `yield a` (yield_expression is NOT in
// bare_primary_expression — it would recurse through expression →
// bare towers) and orphans `, self[b]` with no backtrack. The paren form is
// unambiguous (`(` directly after `yield` never means anything else in the
// bare tower), so it joins bare_primary_expression with zero shape change
// elsewhere (goldens confirm — the arm fails fast without LPAREN).
private yield_paren_expression ::= YIELD LPAREN NLS argument_list NLS RPAREN
// Multi-arg bare `yield` INSIDE a group (`(yield a, self[b])` —
// named_tuple.cr `map` macro body): the bare `expression` arm of the flat
// macro_array_tail alternatives commits on `yield a` (yield_expression can't
// join bare_primary — it would recurse) and orphans `, self[b]` with no
// backtrack. Commits only when a COMMA follows the first value (plain
// `yield a` / `(yield a)` keep their shapes — goldens confirm); the rest of
// the values are plain `expression`s (NOT yield_expression — no left
// recursion: the head YIELD token is consumed before the values parse).
// No new PSI type: bare_argument leaves flatten like any bare list.
private yield_bare_multiarg ::= YIELD &(bare_expression COMMA) bare_expression (COMMA NLS bare_expression)+
                                  | yield_expression

bare_method_call_expression ::= [DOUBLE_COLON] (IDENTIFIER | CONSTANT | RESPONDS_TO | IS_A | NIL_QUESTION) call_args {
  mixin="io.github.unurgunite.crystal.psi.impl.CrystalBareMethodCallExpressionMixin"
}

block ::= DO [PIPE NLS parameter_list NLS PIPE] statement_list rescue_clause* [else_clause] [ensure_clause] END
        | LBRACE [PIPE NLS parameter_list NLS PIPE] statement_list RBRACE

// Proc/Lambda literal: ->{ body }, ->(params) { body }, ->method_name(types),
// and the do-block form `-> do ... end` / `->(params) do ... end`
// (e.g. `LibGC.set_start_callback -> do ... end`).
proc_literal ::= ARROW LPAREN NLS proc_parameter_list NLS RPAREN LBRACE statement_list RBRACE
               | ARROW LPAREN NLS proc_parameter_list NLS RPAREN DO statement_list END
               | ARROW LBRACE statement_list RBRACE
               | ARROW DO statement_list END
               | ARROW (instance_var_access | class_var_access | IDENTIFIER | CONSTANT) [DOT (IDENTIFIER | CONSTANT)] [LPAREN type_reference (COMMA type_reference)* RPAREN] {pin=1}

// Proc parameter list: like parameter_list but macro controls may sit at the
// edges without commas of their own (`->({% for i in 0...n %} arg{{i}} : T,
// {% end %}) { ... }` — proc.cr: a NEWLINE, not a comma, follows the header
// control). Delegates to the plain parameter_list (so the PARAMETER_LIST PSI
// node keeps its shape — inspections read it); edge controls are eaten by
// proc_lead/proc_trail, mid-list controls ride parameter_item's macro_control
// alternative. PEG: lead/trail fail fast without `{%` (zero impact on plain
// lists). `{% %}` in `def` params is a real syntax error, tolerated as grammar
// union (only the `->()` form needs it — see parameter_item note).
private proc_parameter_list ::= [proc_lead? parameter_list proc_trail?]
private proc_lead ::= macro_control (NLS macro_control)* NLS?
private proc_trail ::= NLS macro_control (NLS macro_control)*

// ==================== Literals ====================

private literal ::= INTEGER_LITERAL
                  | FLOAT_LITERAL
                  | CHAR_LITERAL
                  | string_expression
                  | symbol_string_expression
                  | SYMBOL_LITERAL
                  | bracket_type_label
                  // Symbol from macro interpolation (`:{{name.id}}` —
                  // colorize.cr: only legal inside `{% %}` in real crystal,
                  // accepted here as context-insensitive union, same
                  // precedent as `fun {{...}}` names. Disjoint first token
                  // (COLON): `::` lexes DOUBLE_COLON, named-arg/hash/ternary
                  // COLONs are consumed by their own rules — zero shape
                  // change elsewhere (goldens confirm).
                  | COLON macro_interpolation
                  | regex_expression
                  | command_expression
                  | NIL
                  | TRUE
                  | FALSE
                  | SELF
                  | SUPER
                  | PREVIOUS_DEF
                  | heredoc_literal
                  | percent_literal

string_expression ::= (STRING_LITERAL | STRING_ESCAPE | STRING_INTERPOLATION_BEGIN expression STRING_INTERPOLATION_END)+

regex_expression ::= REGEX_BEGIN (REGEX_LITERAL | STRING_ESCAPE | STRING_INTERPOLATION_BEGIN expression STRING_INTERPOLATION_END)* REGEX_END

command_expression ::= COMMAND_BEGIN (COMMAND_LITERAL | STRING_ESCAPE | STRING_INTERPOLATION_BEGIN expression STRING_INTERPOLATION_END)* COMMAND_END

heredoc_literal ::= HEREDOC_START (HEREDOC_CONTENT | STRING_ESCAPE | STRING_INTERPOLATION_BEGIN expression STRING_INTERPOLATION_END)* HEREDOC_END?

percent_literal ::= PERCENT_LITERAL_BEGIN percent_literal_content* PERCENT_LITERAL_END
                  | PERCENT_SYMBOL_BEGIN percent_symbol_content* PERCENT_SYMBOL_END

private percent_literal_content ::= STRING_LITERAL | STRING_ESCAPE | STRING_INTERPOLATION_BEGIN expression STRING_INTERPOLATION_END | SYMBOL_LITERAL | REGEX_LITERAL | COMMAND_LITERAL | NEWLINE

private percent_symbol_content ::= SYMBOL_LITERAL | NEWLINE

symbol_string_expression ::= SYMBOL_COLON (STRING_LITERAL | STRING_ESCAPE | STRING_INTERPOLATION_BEGIN expression STRING_INTERPOLATION_END)+

// `[] of T1, T2, ... -> Ret?`: the `of` argument is a multi-param PROC type
// (`[] of Int32, ::Exception? ->` — at_exit_handlers.cr). Verified with real
// crystal 1.21.0: `[] of Int32, String` (no arrow) is a SYNTAX ERROR
// ("expecting token '->'"), so the ARROW is REQUIRED — never optional.
// That requirement is also the disambiguator: `[] of String, path = "..."`
// (param defaults — loader/unix.cr, ast.cr, debug.cr, ...) fails the tail
// (no arrow after `path`) and backtracks to plain `[] of String`, leaving
// `, path = ...` to parameter_list. No pin: the tail must roll back cleanly.
// Members are type_union (NOT type_reference): a member type_reference would
// eat the tail's own `-> Ret` through its proc-type arm (`::Exception? ->
// Nil` matched as one member), starving the required outer ARROW with no
// backtrack.
// The tail is a NAMED rule (own PSI node): inlining type_union directly
// would flatten expression-typed leaves into ARRAY_LITERAL and make
// GrammarKit emit a duplicate flat+wrapper getExpressionList() overload
// pair that breaks kotlinc (same trap as tuple_literal — verified).
// The resolver reads the first type_reference (unchanged); extra members
// live under the tail node.
// Label-element arrays (`[a : Int32]`, `[a : Int32, b : Int32]` — verified
// legal with real crystal 1.21.0; instructions.cr `operands: [value : Int64]`
// shape): the label alternative comes LAST — plain `[a]`, `[a, b]`, `[a: 1]`
// commit through expression_list first (zero shape change, goldens confirm);
// only a `name COLON Type` element (which expression_list can never finish —
// the COLON orphans) falls through here. Only the FIRST element carries the
// brackets; the rest are plain `name : Type` pairs (real shape). No new PSI
// type: label leaves sit directly in ARRAY_LITERAL; getExpressionList() is
// empty for label arrays (the resolver already returns null on empty).
array_literal ::= LBRACKET NLS [expression_list] NLS RBRACKET [OF type_reference array_of_tail?]
                | LBRACKET NLS bare_arg_name COLON type_reference (NLS COMMA NLS bare_arg_name COLON type_reference)* [NLS COMMA] NLS RBRACKET
array_of_tail ::= (COMMA NLS type_union)+ ARROW [type_reference]

// Array with macro-generated elements (`[{% for %} (yield ...), {% end %}]`
// — named_tuple.cr `map`): the generated elements carry their own commas as
// flat tokens (same precedent as hash_entry_list's `{%` alternative and
// for_body). Inlined siblings (NOT a named wrapper — that emits the duplicate
// flat+wrapper getExpressionList() overload pair that breaks kotlinc /
// CrystalCollectionTypeResolver, verified): the plain expression_list arm is
// tried first via the `!MACRO_CONTROL_BEGIN` guard so macro-free arrays keep
// their shape; the flat form commits only on a leading `{%` (fail-fast).
// The flattened leaves sit directly in ARRAY_LITERAL (no new element types).
// `expression` precedes `macro_control_token` (PEG ordered choice): a token
// match on CONSTANT/IDENTIFIER (`ENV` in `ENV["B"]`) strands brackets/dots —
// the index `]` then trips the loop's `!RBRACKET` guard and the whole tail
// fails with `got ','` (verified 2026-09-16: cache_dir.cr). Maximal munch
// first; tokens cover only what expression can't start. Failure backtracks
// to the choice point, so keywords/operators still fall through to tokens.
macro_array_tail ::= LBRACKET NLS &MACRO_CONTROL_BEGIN (!RBRACKET (yield_bare_multiarg | yield_paren_expression | macro_control | macro_interpolation | expression | macro_control_token | COMMA | NEWLINE))+ NLS RBRACKET [OF type_reference array_of_tail?]

hash_literal ::= LBRACE NLS [hash_entry_list] NLS RBRACE [OF type_reference DOUBLE_ARROW type_reference]

// Macro-generated hash/tuple bodies (`{% for %} k => v, {% end %}` —
// tuple.cr): the generated entries carry their own commas as flat tokens.
// The macro-bearing `{% begin %} { {% for %} ... } {% end %}` shape is
// covered by the `{% begin %}`-macro_control_in_expression path — no dedicated
// tuple alternative (an inline flat alternative makes GrammarKit emit a
// duplicate getExpressionList() overload pair that breaks javac — verified).
tuple_literal ::= LBRACE NLS expression_list NLS RBRACE

// Macro-generated hash/tuple bodies (`{% for %} k => v, {% end %}` —
// tuple.cr): the generated entries carry their own commas as flat tokens, so
// the body accepts macro controls and raw control tokens alongside plain
// entries (same flat-token precedent as for_body). PEG: the plain entry list
// stays first (zero shape change when macro-free); the flat alternative
// commits only when a macro control opens the body (fail-fast `{%` guard).
hash_entry_list ::= &MACRO_CONTROL_BEGIN (!RBRACE (macro_control | hash_entry | macro_interpolation | macro_control_token | COMMA | NEWLINE))+
                  // Line-break-separated entries without commas (`{a: {...}\n b:
                  // {...}}` — instructions.cr hash-of-hashes): real crystal
                  // treats a newline after a complete entry as a separator
                  // (verified 1.21.0 — `mc9` with-comma and `mc8` without both
                  // legal). Trailing-NEWLINE `each` guard: without it the
                  // `(NLS hash_entry)` arm matches EVERY entry boundary's
                  // newline then fails the entry, and PEG — no backtrack past
                  // a consumed repetition — drops the whole list (goldens
                  // regress). With the guard the arm only fires when an entry
                  // really follows (or `{%`, via the second arm).
                  | hash_entry ((NLS COMMA | NLS &hash_entry) NLS (hash_entry | macro_control) | NLS macro_control)* [NLS COMMA]

// PEG LONGER-FIRST: the bracket_type_label alternative MUST precede the
// expression-led one — both match `[value`, but only the label survives the
// COLON (`operands: [value : Int64]` broke: the expression arm committed on
// `[value` and orphaned the COLON with no backtrack — instructions.cr).
// Fails fast on `[a]`, `[a, b]`, `x[0]` (no COLON after the name → next
// alternative). The label also lives in `literal` (argument/call-bracket
// positions) and in `argument` (call args) — same fail-fast, no churn.
// Grouped-value hash entries (`code: (stack - size)` — instructions.cr:
// the expression arm commits on the INNER `stack` and orphans the MINUS,
// same no-backtrack trap as the label above) get their own first
// alternative — grouped_named_value (group + postfix chain).
hash_entry ::= grouped_named_value
             | bracket_type_label
             // Value may be a setter-chain assignment (`code: (stack -
             // size).as(Int32*).value = type_id` — instructions.cr): the plain
             // `expression` commits on the receiver chain and orphans the
             // trailing `= tid` with no backtrack. `assignment` first
             // (fail-fast on non-assignables — plain values keep the
             // expression shape, goldens confirm). No new PSI type.
             | expression (DOUBLE_ARROW | COLON) (assignment | expression)

// ==================== Variable References ====================

// Macro fresh variable (`%var`, `%var{i}` — json/from_json.cr, iterator.cr):
// real crystal lexes `%`+ident as one MACRO_VAR token outside percent
// literals (verified in the 1.21.0 lexer source); here the lexer emits
// PERCENT + pushback and the parser combines them. Commits only on
// `%`+IDENTIFIER (plain `%` modulo / `%w(`/`%q(` literals fail fast —
// longest-match + rule order keep them). Optional `{...}` index suffix
// (`%var{key.id}` — parsed as a grouped expression). Named element (Go to
// Definition / rename ride the existing variable machinery).
fresh_var ::= PERCENT IDENTIFIER [LBRACE expression RBRACE] {
  mixin="io.github.unurgunite.crystal.psi.impl.CrystalVariableReferenceMixin"
  implements="io.github.unurgunite.crystal.psi.CrystalNamedElement"
}

instance_var_access ::= AT macro_interpolation | INSTANCE_VAR {
  mixin="io.github.unurgunite.crystal.psi.impl.CrystalInstanceVarAccessMixin"
  implements="io.github.unurgunite.crystal.psi.CrystalNamedElement"
}

class_var_access ::= AT AT macro_interpolation | CLASS_VAR {
  mixin="io.github.unurgunite.crystal.psi.impl.CrystalClassVarAccessMixin"
  implements="io.github.unurgunite.crystal.psi.CrystalNamedElement"
}

// `out` as a receiver (`out.copy_from(...)`, `out.value` reads — slice/sort.cr;
// verified legal) joins variable_reference like UNION/TYPE. Only over-acceptance
// is bare `puts out` (a real syntax error, unobserved in stdlib, harmless).
// Assignment targets use `variable` (which also has OUT) via the assignment rules.
variable_reference ::= GLOBAL_VAR | CONSTANT | IDENTIFIER macro_interpolation | IDENTIFIER | OF | WHEN | UNION | TYPE | OUT | SELF | IS_A | NIL_QUESTION | RESPONDS_TO | fresh_var {
  mixin="io.github.unurgunite.crystal.psi.impl.CrystalVariableReferenceMixin"
}

// A `{{...}}` interpolation standing in for a whole expression statement
// (`{{method.id}} path, form: body` — macro-generated bare calls; the callee
// name is macro-generated so the parser cannot see it). Allowed as a bare
// callee with trailing bare arguments.
// `!binary_op_lookahead` (same guard as the plain callee alternative):
// `foo({{ x }} - other)` is binary minus (verified with real crystal 1.21.0
// via `crystal run`: `foo({{ 10 }} - 3)` passes 7, not two args) — without
// the guard the `- other` parses as a unary-minus bare arg and orphans the
// binary shape (big_int.cr hash values). Legit `{{m}} path, ...` unaffected:
// `path` is not an operator, guard passes.
private macro_callee_call ::= macro_interpolation !binary_op_lookahead bare_argument_list

// ==================== Type References ====================

type_reference ::= type_union [ARROW [type_union]]
                 | ARROW [type_union]

private type_union ::= type_single (PIPE NLS type_single)*

// A type with arguments used as a method-call receiver, e.g. `Hash(K, V).new` or
// `Pointer(T*).malloc`. The `&DOT` lookahead keeps it from shadowing an ordinary
// method call `Foo(x)` that is not followed by a member access.
type_receiver_expression ::= type_path type_arguments &DOT

private type_single ::= STAR type_path [type_arguments] [QUESTION]
                      | type_path macro_interpolation [QUESTION]
                      | type_path LPAREN NLS IDENTIFIER COLON type_reference (NLS COMMA NLS IDENTIFIER COLON type_reference)* [NLS COMMA] NLS RPAREN [QUESTION]
                      | type_path [type_arguments] [DOT CLASS] [QUESTION] (STAR | DOUBLE_STAR)* type_index_args* [QUESTION]
                      | SELF STAR [QUESTION]
                      | SELF STAR [QUESTION]
                      | SELF [QUESTION]
                      | TYPEOF LPAREN NLS expression (COMMA NLS expression)* NLS RPAREN [QUESTION]
                      | LPAREN type_reference (COMMA type_reference)* RPAREN [QUESTION]
                      | LBRACE NLS IDENTIFIER COLON type_reference (NLS COMMA NLS IDENTIFIER COLON type_reference)* NLS RBRACE [QUESTION] (STAR | DOUBLE_STAR)*
                      | LBRACE NLS type_reference (NLS COMMA NLS type_reference)* NLS RBRACE [QUESTION] (STAR | DOUBLE_STAR)*
                      | macro_interpolation (DOT (CLASS | IDENTIFIER | CONSTANT))* [QUESTION]
                      | macro_interpolation [QUESTION]
                      | IDENTIFIER

type_path ::= [DOUBLE_COLON] (CONSTANT | macro_interpolation) (DOUBLE_COLON (CONSTANT | macro_interpolation))* {
  mixin="io.github.unurgunite.crystal.psi.impl.CrystalTypePathMixin"
}


type_arguments ::= LPAREN NLS type_argument (NLS COMMA NLS type_argument)* [NLS COMMA] NLS RPAREN

private type_argument ::= type_reference | INTEGER_LITERAL

// Static/named index on a type (`UInt8[16]`, `UInt8[LibC::MAX_PATH]`,
// `NamedTuple(time: Time)` as a type): subsumes `static_array_size`
// (`[INTEGER]`). A single bare CONSTANT stays a raw token (old shape — it reads
// as a value size like `SS_SIZE`, not a type); only `::`-paths and complex
// members go through `type_reference`. PEG order: INTEGER, guarded CONSTANT,
// then the general reference (which would also match the first two).
private type_index_args ::= LBRACKET NLS type_index_arg (NLS COMMA NLS type_index_arg)* NLS RBRACKET
private type_index_arg ::= INTEGER_LITERAL | CONSTANT !DOUBLE_COLON | type_reference

type_parameters ::= LPAREN NLS type_parameter_item (COMMA NLS type_parameter_item)* [COMMA] NLS RPAREN

private type_parameter_item ::= [STAR] CONSTANT [ASSIGN type_reference]

// ==================== Type Names ====================

private type_name ::= (CONSTANT | macro_interpolation) (DOUBLE_COLON (CONSTANT | macro_interpolation))*

// ==================== Typeof / Sizeof ====================

typeof_expression ::= TYPEOF LPAREN NLS expression (COMMA NLS expression)* NLS RPAREN {pin=1}

sizeof_expression ::= SIZEOF LPAREN NLS type_reference NLS RPAREN {pin=1}

instance_sizeof_expression ::= INSTANCE_SIZEOF LPAREN NLS type_reference NLS RPAREN {pin=1}

pointerof_expression ::= POINTEROF LPAREN NLS (postfix_expression | instance_var_access | class_var_access | variable_reference) NLS RPAREN {pin=1}

offsetof_expression ::= OFFSETOF LPAREN NLS type_reference COMMA NLS instance_var_access NLS RPAREN {pin=1}

// Bare `uninitialized` without a type (`f(uninitialized, nil)` —
// type_declaration_visitor.cr:277) is legal (verified 1.21.0) — the type is
// optional. pin=1 keeps the UNINITIALIZED commit; a missing type just yields
// a typeless node (no error, no shape change for the typed form).
uninitialized_expression ::= UNINITIALIZED [type_reference] {pin=1}

asm_expression ::= ASM LPAREN NLS string_expression NLS [asm_sections] NLS RPAREN {pin=1}

// ASM sections: up to 4 colon-separated sections (outputs, inputs, clobbers, options)
// DOUBLE_COLON (::) counts as two consecutive colons (skipping a section)
private asm_sections ::= DOUBLE_COLON NLS COLON NLS [asm_clobber_list] [NLS COLON NLS [asm_option_list]]
                       | DOUBLE_COLON NLS [asm_operand_list] [NLS COLON NLS [asm_clobber_list] [NLS COLON NLS [asm_option_list]]]
                       | COLON NLS [asm_operand_list] NLS DOUBLE_COLON NLS [asm_clobber_list] [NLS COLON NLS [asm_option_list]]
                       | COLON NLS [asm_operand_list] [NLS COLON NLS [asm_operand_list] [NLS COLON NLS [asm_clobber_list] [NLS COLON NLS [asm_option_list]]]]

private asm_operand_list ::= asm_operand (NLS COMMA NLS asm_operand)*

asm_operand ::= string_expression LPAREN expression RPAREN

private asm_clobber_list ::= string_expression (NLS COMMA NLS string_expression)*

private asm_option_list ::= string_expression (NLS COMMA NLS string_expression)*

// ==================== Expression Lists ====================

// Elements may be assignments (`case {a = f(x), b = g(y)}` — complex.cr:
// Crystal evaluates the assignments, the tuple holds the values). Assignment
// first (PEG longer-first: lone `a` also matches `expression`, but
// the ASSIGN tail must win). Fails before pin when no ASSIGN follows, so
// plain elements backtrack cleanly with zero shape change (goldens confirm).
// Macro controls as elements (`{elem, {% for %} x{{i}}, {% end %}}`,
// `[a, {% if %} y, {% end %}]` — enumerable.cr `zip?`, cache_dir.cr,
// all verified legal 1.21.0): the `{%...%}` chunks are lone controls with
// no commas of their own; the list commas separate them like real elements
// (same precedent as argument_list's macro_control alternative).
// Controls are TRANSPARENT to comma rhythm: `a, {% if %} y, {% end %}, b` —
// after a control an element may follow WITHOUT a comma (the comma belongs
// to the generated code: `{% if %} y,`), and `{% end %}` may sit bare before
// `]`/`)`. Without this the inner `y,` breaks macro_if_expression (which
// needs the control right after the expression) and the bare `{% if %}`
// matches as a lone item, orphaning `y` with `got 'ENV'` (verified
// 2026-09-16: cache_dir.cr). The control branch OWNS its leading comma
// (`[NLS COMMA]`): otherwise the plain comma-branch matches `, {% if %}`
// first (PEG ordered choice) and strands the element (verified 2026-09-16).
// AND the plain branch carries `!MACRO_CONTROL_BEGIN` after its comma:
// `expression` itself matches a bare `{%...%}` (via primary→macro_control),
// so without the token guard the plain branch STILL eats `, {% if %}` first
// (verified 2026-09-16, second round of the same bug). Token-level `!` is
// safe here (unlike `!`/`&` before composites). LAST in items (plain
// elements commit first — zero shape change when macro-free).
// Flat (no wrapper — the duplicate-getter trap).
expression_list ::= (assignment | expression | macro_control) ((NLS COMMA NLS !MACRO_CONTROL_BEGIN (assignment | expression)) | ([NLS COMMA] NLS macro_control [NLS (assignment | expression)]))* [NLS COMMA]

// ==================== Helper Rules ====================

private NLS ::= NEWLINE*
